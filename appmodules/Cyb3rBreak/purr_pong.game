"""
Purr Pong — A neon synthwave tribute to the 1972 Pong.

Features
--------
- 1P vs AI or 2P local multiplayer
- Classic paddle-bounce physics: bounce angle depends on where the ball hits
- Procedurally generated retro sound effects (no external .wav files needed)
- Achievement system with sliding popup notifications ("Meow!")
- Persistent leaderboard saved to leaderboard.json
- Cat-themed UI: paddles wear tiny cat ears, achievement popups say "Meow!"

Controls
--------
- Player 1 (left):        W / S
- Player 2 / AI (right):  Up / Down arrows
- Menu navigation:        Up/Down + Enter, or mouse click
- Pause:                  P    |   Quit to menu:  ESC
- Restart after a match:  R

Run
---
    pip install pygame numpy
    python purr_pong.py
"""

import json
import math
import random
import datetime
from pathlib import Path
from typing import List, Optional, Tuple

import numpy as np
import pygame


# ======================================================================
# CONFIGURATION
# ======================================================================
SCREEN_WIDTH, SCREEN_HEIGHT = 1024, 640
FPS = 60

PADDLE_WIDTH, PADDLE_HEIGHT = 14, 100
PADDLE_MARGIN = 30
PADDLE_SPEED = 7.5
AI_SPEED = 5.8

BALL_SIZE = 14
INITIAL_BALL_SPEED = 6.0
MAX_BALL_SPEED = 13.0
SPEED_INCREMENT = 0.4
MAX_BOUNCE_DEG = 60.0

WINNING_SCORE = 11
ACHV_CONSECUTIVE_HITS = 5
ACHV_COMEBACK_DEFICIT = 5
ACHV_CENTURY_HITS = 100

BASE_DIR = Path(__file__).resolve().parent
LEADERBOARD_FILE = BASE_DIR / "leaderboard.json"

# Neon synthwave palette
COLOR_BG_TOP    = (12, 8, 38)
COLOR_BG_BOTTOM = (28, 14, 60)
COLOR_NET       = (140, 80, 200)
COLOR_PINK      = (255, 70, 170)
COLOR_CYAN      = (60, 240, 255)
COLOR_YELLOW    = (255, 230, 90)
COLOR_GREEN     = (110, 255, 160)
COLOR_RED       = (255, 90, 110)
COLOR_WHITE     = (245, 245, 250)
COLOR_DIM       = (140, 140, 170)
COLOR_POPUP_BG  = (40, 20, 70)

# Game states
STATE_MENU         = "menu"
STATE_PLAYING      = "playing"
STATE_PAUSED       = "paused"
STATE_GAME_OVER    = "game_over"
STATE_NAME_ENTRY   = "name_entry"
STATE_LEADERBOARD  = "leaderboard"


# ======================================================================
# HELPERS
# ======================================================================
def lerp(a: float, b: float, t: float) -> float:
    return a + (b - a) * t


def clamp(v: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, v))


def make_background(width: int, height: int) -> pygame.Surface:
    """Pre-render a vertical gradient background with a horizon glow."""
    surf = pygame.Surface((width, height)).convert()
    for y in range(height):
        t = y / max(1, height - 1)
        r = int(lerp(COLOR_BG_TOP[0], COLOR_BG_BOTTOM[0], t))
        g = int(lerp(COLOR_BG_TOP[1], COLOR_BG_BOTTOM[1], t))
        b = int(lerp(COLOR_BG_TOP[2], COLOR_BG_BOTTOM[2], t))
        pygame.draw.line(surf, (r, g, b), (0, y), (width, y))
    # Subtle horizon glow near the bottom
    glow = pygame.Surface((width, 100), pygame.SRCALPHA)
    for i in range(100):
        alpha = int(70 * (1 - i / 100) ** 1.6)
        pygame.draw.line(glow, (255, 100, 200, alpha), (0, i), (width, i))
    surf.blit(glow, (0, height - 100), special_flags=pygame.BLEND_ADD)
    # A few scattered "stars" up top for synthwave flavor
    rng = random.Random(7)
    for _ in range(60):
        sx = rng.randint(0, width - 1)
        sy = rng.randint(0, height // 2)
        b = rng.randint(120, 220)
        surf.set_at((sx, sy), (b, b, b + 20))
    return surf


def draw_cat_paddle(surface: pygame.Surface, x: int, y: int, w: int, h: int,
                    color: Tuple[int, int, int]) -> None:
    """Draw a paddle with cute cat ears on top corners."""
    # Body with rounded corners
    body_rect = pygame.Rect(x, y, w, h)
    pygame.draw.rect(surface, color, body_rect, border_radius=4)
    # Inner highlight stripe
    hl_color = tuple(min(255, c + 50) for c in color)
    highlight = pygame.Rect(x + 2, y + 6, max(2, w - 4), max(2, h - 12))
    pygame.draw.rect(surface, hl_color, highlight, border_radius=3)
    # Cat ears (two triangles on top corners)
    ear_h, ear_w = 10, 12
    left_ear  = [(x, y), (x + ear_w, y), (x + ear_w // 2, y - ear_h)]
    right_ear = [(x + w, y), (x + w - ear_w, y), (x + w - ear_w // 2, y - ear_h)]
    pygame.draw.polygon(surface, color, left_ear)
    pygame.draw.polygon(surface, color, right_ear)
    # Inner ear (pink)
    inner_color = (255, 180, 200)
    pygame.draw.polygon(surface, inner_color, [
        (x + 2, y - 1),
        (x + ear_w - 2, y - 1),
        (x + ear_w // 2, y - ear_h + 3)
    ])
    pygame.draw.polygon(surface, inner_color, [
        (x + w - 2, y - 1),
        (x + w - ear_w + 2, y - 1),
        (x + w - ear_w // 2, y - ear_h + 3)
    ])


def draw_ball(surface: pygame.Surface, x: float, y: float, size: int,
              color: Tuple[int, int, int]) -> None:
    """Draw a glowing ball with a halo and inner shine."""
    # Glow halo
    halo_size = size * 4
    halo = pygame.Surface((halo_size, halo_size), pygame.SRCALPHA)
    center = halo_size // 2
    for r in range(size * 2, 0, -2):
        alpha = int(70 * (1 - r / (size * 2)) ** 2)
        pygame.draw.circle(halo, (*color, alpha), (center, center), r)
    surface.blit(halo, (int(x) - center, int(y) - center),
                 special_flags=pygame.BLEND_ADD)
    # Solid ball
    pygame.draw.circle(surface, color, (int(x), int(y)), size)
    # Inner shine
    pygame.draw.circle(surface, COLOR_WHITE,
                       (int(x - size / 3), int(y - size / 3)),
                       max(2, size // 3))


def draw_dashed_line(surface: pygame.Surface, color, x: int, top: int,
                     bottom: int, dash: int = 14, gap: int = 14,
                     width: int = 3) -> None:
    y = top
    while y < bottom:
        y2 = min(y + dash, bottom)
        pygame.draw.line(surface, color, (x, y), (x, y2), width)
        y += dash + gap


def draw_cat_face(surface: pygame.Surface, cx: int, cy: int, size: int,
                  color: Tuple[int, int, int] = COLOR_YELLOW) -> None:
    """Draw a small cat face icon — used in title and popups."""
    # Head
    pygame.draw.circle(surface, color, (cx, cy), size)
    # Ears
    pygame.draw.polygon(surface, color, [
        (cx - size, cy - size // 2),
        (cx - size // 2, cy - size),
        (cx - size // 4, cy - size // 2)
    ])
    pygame.draw.polygon(surface, color, [
        (cx + size, cy - size // 2),
        (cx + size // 2, cy - size),
        (cx + size // 4, cy - size // 2)
    ])
    # Eyes
    eye_r = max(2, size // 6)
    pygame.draw.circle(surface, COLOR_BG_TOP, (cx - size // 3, cy - 1), eye_r)
    pygame.draw.circle(surface, COLOR_BG_TOP, (cx + size // 3, cy - 1), eye_r)
    # Nose
    pygame.draw.polygon(surface, COLOR_PINK, [
        (cx - 2, cy + size // 4),
        (cx + 2, cy + size // 4),
        (cx, cy + size // 4 + 3)
    ])
    # Whiskers
    for offset in (-2, 2):
        pygame.draw.line(surface, COLOR_WHITE,
                         (cx - size, cy + offset), (cx - size // 2, cy + offset), 1)
        pygame.draw.line(surface, COLOR_WHITE,
                         (cx + size // 2, cy + offset), (cx + size, cy + offset), 1)


# ======================================================================
# SOUND MANAGER  — procedurally generates retro sound effects
# ======================================================================
class SoundManager:
    """Generates short retro tones using numpy and pygame.mixer.

    The whole game keeps running even if the audio backend fails to
    initialise — every play() call is a no-op in that case.
    """

    def __init__(self) -> None:
        self.enabled: bool = False
        self.sounds: dict = {}
        self.sample_rate: int = 44100
        try:
            pygame.mixer.pre_init(44100, -16, 2, 256)
            pygame.mixer.init()
            self.sample_rate = pygame.mixer.get_init()[0]
            self.enabled = True
            self._generate_all()
            print("[SoundManager] Audio initialised OK")
        except Exception as e:  # noqa: BLE001 — we want a broad net here
            print(f"[SoundManager] Audio disabled: {e}")
            self.enabled = False

    # ---- internal helpers -------------------------------------------
    def _to_sound(self, mono_float: np.ndarray) -> pygame.mixer.Sound:
        mono_float = np.clip(mono_float, -1.0, 1.0)
        stereo = np.column_stack([mono_float, mono_float])
        audio = (stereo * 32767).astype(np.int16)
        return pygame.sndarray.make_sound(audio)

    def _tone(self, freq: float, duration: float, decay: float = 20.0,
              volume: float = 0.5,
              harmonics: Optional[List[Tuple[float, float]]] = None
              ) -> pygame.mixer.Sound:
        sr = self.sample_rate
        n = int(sr * duration)
        t = np.linspace(0, duration, n, endpoint=False)
        env = np.exp(-t * decay)
        wave = np.sin(2 * np.pi * freq * t)
        if harmonics:
            for h_freq, h_amp in harmonics:
                wave = wave + h_amp * np.sin(2 * np.pi * h_freq * t)
        return self._to_sound(volume * env * wave)

    def _sweep(self, f0: float, f1: float, duration: float,
               decay: float = 4.0, volume: float = 0.5) -> pygame.mixer.Sound:
        sr = self.sample_rate
        n = int(sr * duration)
        t = np.linspace(0, duration, n, endpoint=False)
        freq = f0 + (f1 - f0) * (t / duration)
        # Phase = integral of frequency
        phase = 2 * np.pi * np.cumsum(freq) / sr
        env = np.exp(-t * decay)
        return self._to_sound(volume * env * np.sin(phase))

    def _chord(self, freqs: List[float], duration: float,
               decay: float = 3.0, volume: float = 0.4) -> pygame.mixer.Sound:
        sr = self.sample_rate
        n = int(sr * duration)
        t = np.linspace(0, duration, n, endpoint=False)
        env = np.exp(-t * decay)
        wave = np.zeros_like(t)
        for f in freqs:
            wave += np.sin(2 * np.pi * f * t)
        wave /= max(1, len(freqs))
        return self._to_sound(volume * env * wave)

    def _generate_all(self) -> None:
        # Paddle hit: bright blip with a harmonic
        self.sounds['paddle'] = self._tone(
            440, 0.08, decay=30, volume=0.5, harmonics=[(880, 0.2)]
        )
        # Wall bounce: lower thud
        self.sounds['wall'] = self._tone(220, 0.10, decay=18, volume=0.45)
        # Score: rising sweep
        self.sounds['score'] = self._sweep(440, 1320, 0.4, decay=3.5, volume=0.55)
        # Achievement: bright triad chime
        self.sounds['achievement'] = self._chord(
            [880, 1320, 1760], 0.55, decay=3.0, volume=0.45
        )
        # Menu click
        self.sounds['menu'] = self._tone(660, 0.05, decay=60, volume=0.35)
        # Win fanfare
        self.sounds['win'] = self._chord(
            [523, 659, 784, 1047], 0.9, decay=2.0, volume=0.5
        )
        # Lose: descending sweep
        self.sounds['lose'] = self._sweep(400, 100, 0.7, decay=2.5, volume=0.5)

    # ---- public API -------------------------------------------------
    def play(self, name: str) -> None:
        if not self.enabled:
            return
        s = self.sounds.get(name)
        if s is None:
            return
        try:
            s.play()
        except Exception:  # noqa: BLE001
            pass  # never let audio errors crash gameplay


# ======================================================================
# ACHIEVEMENTS
# ======================================================================
ACHIEVEMENT_DEFS = [
    {"id": "first_blood",  "title": "First Blood!",
     "desc": "Score your very first point.",            "meow": "Meow! First blood!"},
    {"id": "unstoppable",  "title": "Unstoppable",
     "desc": f"{ACHV_CONSECUTIVE_HITS} paddle hits in a row.",
     "meow": "Meow! Unstoppable!"},
    {"id": "flawless",     "title": "Flawless Victory",
     "desc": "Win a match without conceding a point.",
     "meow": "Purrfect victory!"},
    {"id": "speed_demon",  "title": "Speed Demon",
     "desc": "Push the ball to its maximum speed.",
     "meow": "Meow! Zoomies!"},
    {"id": "comeback",     "title": "Comeback Kid",
     "desc": "Win after being down by 5+ points.",
     "meow": "Meow! What a comeback!"},
    {"id": "century",      "title": "Centurion",
     "desc": "Land 100 cumulative paddle hits.",
     "meow": "Meow! Century club!"},
]


class AchievementPopup:
    """A single sliding popup notification."""

    def __init__(self, title: str, desc: str, meow: str,
                 font_title: pygame.font.Font, font_desc: pygame.font.Font,
                 font_meow: pygame.font.Font) -> None:
        self.title = title
        self.desc = desc
        self.meow = meow
        self.font_title = font_title
        self.font_desc = font_desc
        self.font_meow = font_meow
        self.life = 3.5  # seconds
        self.age = 0.0
        self.width = 320
        self.height = 78
        self.x_target = SCREEN_WIDTH - self.width - 16
        self.x = SCREEN_WIDTH + 20  # start off-screen right

    def update(self, dt: float) -> bool:
        self.age += dt
        # Slide in (first 0.25s), hold, then slide out (last 0.3s)
        if self.age < 0.25:
            t = self.age / 0.25
            self.x = lerp(SCREEN_WIDTH + 20, self.x_target, 1 - (1 - t) ** 3)
        elif self.age > self.life - 0.3:
            t = (self.age - (self.life - 0.3)) / 0.3
            self.x = lerp(self.x_target, SCREEN_WIDTH + 20, t ** 3)
        else:
            self.x = self.x_target
        return self.age < self.life

    def draw(self, surface: pygame.Surface, y_offset: int) -> None:
        rect = pygame.Rect(int(self.x), 16 + y_offset, self.width, self.height)
        # Background panel
        panel = pygame.Surface((self.width, self.height), pygame.SRCALPHA)
        panel.fill((*COLOR_POPUP_BG, 230))
        pygame.draw.rect(panel, COLOR_YELLOW, panel.get_rect(), 2, border_radius=6)
        surface.blit(panel, rect.topleft)
        # Cat face icon
        draw_cat_face(surface, rect.left + 24, rect.centery, 16, color=COLOR_YELLOW)
        # Title
        title_surf = self.font_title.render(self.title, True, COLOR_YELLOW)
        surface.blit(title_surf, (rect.left + 50, rect.top + 6))
        # Description
        desc_surf = self.font_desc.render(self.desc, True, COLOR_WHITE)
        surface.blit(desc_surf, (rect.left + 50, rect.top + 28))
        # Meow!
        meow_surf = self.font_meow.render(self.meow, True, COLOR_PINK)
        surface.blit(meow_surf, (rect.left + 50, rect.top + 50))


class AchievementManager:
    """Tracks unlocked achievements and manages popups."""

    def __init__(self, sounds: SoundManager,
                 font_title: pygame.font.Font,
                 font_desc: pygame.font.Font,
                 font_meow: pygame.font.Font) -> None:
        self.unlocked: set = set()
        self.popups: List[AchievementPopup] = []
        self.sounds = sounds
        self.font_title = font_title
        self.font_desc = font_desc
        self.font_meow = font_meow

    def reset_run(self) -> None:
        """Reset per-match state without erasing all-time unlocks."""
        # Persist `century` counter etc. across matches but recheck per-match
        # achievements by keeping a per-match cleared set:
        self.unlocked = set()

    def unlock(self, achievement_id: str) -> None:
        if achievement_id in self.unlocked:
            return
        self.unlocked.add(achievement_id)
        defn = next((a for a in ACHIEVEMENT_DEFS if a["id"] == achievement_id), None)
        if defn is None:
            return
        self.popups.append(AchievementPopup(
            defn["title"], defn["desc"], defn["meow"],
            self.font_title, self.font_desc, self.font_meow
        ))
        self.sounds.play("achievement")

    def update(self, dt: float) -> None:
        self.popups = [p for p in self.popups if p.update(dt)]

    def draw(self, surface: pygame.Surface) -> None:
        for i, p in enumerate(self.popups):
            p.draw(surface, i * (p.height + 8))


# ======================================================================
# LEADERBOARD
# ======================================================================
class Leaderboard:
    """Persistent top-scores list backed by leaderboard.json."""

    def __init__(self, path: Path) -> None:
        self.path = path
        self.entries: List[dict] = []
        self._load()

    def _load(self) -> None:
        try:
            if self.path.exists():
                with open(self.path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if isinstance(data, list):
                    self.entries = data
        except Exception as e:  # noqa: BLE001
            print(f"[Leaderboard] Load failed: {e}")
            self.entries = []

    def save(self) -> None:
        try:
            with open(self.path, "w", encoding="utf-8") as f:
                json.dump(self.entries, f, indent=2, ensure_ascii=False)
        except Exception as e:  # noqa: BLE001
            print(f"[Leaderboard] Save failed: {e}")

    def add(self, name: str, score: int, opponent_score: int,
            mode: str) -> None:
        entry = {
            "name": (name.strip().upper() or "???")[:10],
            "score": int(score),
            "opponent": int(opponent_score),
            "mode": mode,
            "date": datetime.datetime.now().strftime("%Y-%m-%d %H:%M"),
        }
        self.entries.append(entry)
        # Sort by score (margin first), then date desc
        self.entries.sort(
            key=lambda e: (e["score"], -e["opponent"]),
            reverse=True,
        )
        # Keep top 25 entries so the file stays small
        self.entries = self.entries[:25]
        self.save()

    def top(self, n: int = 5) -> List[dict]:
        return self.entries[:n]


# ======================================================================
# PADDLE & BALL
# ======================================================================
class Paddle:
    """A paddle with player or AI control."""

    def __init__(self, x: int, color: Tuple[int, int, int],
                 is_ai: bool = False) -> None:
        self.x = x
        self.y = SCREEN_HEIGHT // 2 - PADDLE_HEIGHT // 2
        self.w = PADDLE_WIDTH
        self.h = PADDLE_HEIGHT
        self.color = color
        self.is_ai = is_ai
        self.vy = 0.0
        self.score = 0

    @property
    def rect(self) -> pygame.Rect:
        return pygame.Rect(self.x, int(self.y), self.w, self.h)

    def move_player(self, up: bool, down: bool, dt: float) -> None:
        speed = PADDLE_SPEED * dt * FPS  # frame-rate independent
        if up and not down:
            self.y -= speed
        elif down and not up:
            self.y += speed
        self.y = clamp(self.y, 0, SCREEN_HEIGHT - self.h)

    def move_ai(self, ball: "Ball", dt: float) -> None:
        """Imperfect tracking AI — only chases when ball comes its way."""
        target = ball.y
        # Add a small random wobble so the AI occasionally misses
        wobble = random.uniform(-18, 18)
        target += wobble
        center = self.y + self.h / 2
        diff = target - center
        # Only react when the ball is heading toward this paddle
        if (self.x > SCREEN_WIDTH // 2 and ball.vx > 0) or \
           (self.x < SCREEN_WIDTH // 2 and ball.vx < 0):
            speed = AI_SPEED * dt * FPS
            if abs(diff) > 6:
                self.y += clamp(diff, -speed, speed)
        else:
            # Drift back toward centre when ball is going away
            center_target = SCREEN_HEIGHT / 2 - self.h / 2
            drift = (center_target - self.y) * 0.04
            self.y += drift
        self.y = clamp(self.y, 0, SCREEN_HEIGHT - self.h)

    def draw(self, surface: pygame.Surface) -> None:
        draw_cat_paddle(surface, self.x, int(self.y), self.w, self.h, self.color)


class Ball:
    """The bouncing ball with classic angle-based paddle physics."""

    def __init__(self) -> None:
        self.size = BALL_SIZE
        self.color = COLOR_CYAN
        self.reset(direction=random.choice([-1, 1]))
        self.speed = INITIAL_BALL_SPEED
        self.total_hits = 0  # for the Centurion achievement

    def reset(self, direction: int = 1) -> None:
        self.x = SCREEN_WIDTH / 2
        self.y = SCREEN_HEIGHT / 2
        self.speed = INITIAL_BALL_SPEED
        # Launch with a small random vertical angle
        angle = random.uniform(-25, 25)
        rad = math.radians(angle)
        self.vx = direction * self.speed * math.cos(rad)
        self.vy = self.speed * math.sin(rad)
        self.frozen = True
        self.freeze_timer = 0.8  # brief pause before launch

    def update(self, dt: float) -> None:
        if self.frozen:
            self.freeze_timer -= dt
            if self.freeze_timer <= 0:
                self.frozen = False
            return
        self.x += self.vx * dt * FPS
        self.y += self.vy * dt * FPS
        # Top/bottom wall bounce
        if self.y - self.size < 0:
            self.y = self.size
            self.vy = abs(self.vy)
            return "wall"
        if self.y + self.size > SCREEN_HEIGHT:
            self.y = SCREEN_HEIGHT - self.size
            self.vy = -abs(self.vy)
            return "wall"
        return None

    def bounce_paddle(self, paddle: Paddle) -> None:
        """Bounce off a paddle. Angle depends on hit position."""
        # relative_y in [-1, 1] where 0 = paddle center
        relative_y = (self.y - (paddle.y + paddle.h / 2)) / (paddle.h / 2)
        relative_y = clamp(relative_y, -1.0, 1.0)
        max_rad = math.radians(MAX_BOUNCE_DEG)
        angle = relative_y * max_rad
        # Speed up slightly each hit
        self.speed = min(self.speed + SPEED_INCREMENT, MAX_BALL_SPEED)
        direction = 1 if paddle.x < SCREEN_WIDTH / 2 else -1
        self.vx = direction * self.speed * math.cos(angle)
        self.vy = self.speed * math.sin(angle)
        # Nudge ball out of the paddle to avoid sticking
        if direction == 1:
            self.x = paddle.x + paddle.w + self.size + 1
        else:
            self.x = paddle.x - self.size - 1
        self.total_hits += 1

    def draw(self, surface: pygame.Surface) -> None:
        draw_ball(surface, self.x, self.y, self.size, self.color)


# ======================================================================
# PARTICLES — small visual sparks on hits
# ======================================================================
class Particle:
    __slots__ = ("x", "y", "vx", "vy", "life", "age", "color", "size")

    def __init__(self, x, y, vx, vy, life, color, size):
        self.x, self.y = x, y
        self.vx, self.vy = vx, vy
        self.life = life
        self.age = 0.0
        self.color = color
        self.size = size

    def update(self, dt: float) -> bool:
        self.age += dt
        self.x += self.vx * dt * FPS
        self.y += self.vy * dt * FPS
        self.vx *= 0.96
        self.vy *= 0.96
        return self.age < self.life

    def draw(self, surface: pygame.Surface) -> None:
        t = self.age / self.life
        alpha = int(255 * (1 - t))
        r = max(1, int(self.size * (1 - t * 0.5)))
        s = pygame.Surface((r * 2, r * 2), pygame.SRCALPHA)
        pygame.draw.circle(s, (*self.color, alpha), (r, r), r)
        surface.blit(s, (int(self.x) - r, int(self.y) - r),
                     special_flags=pygame.BLEND_ADD)


class ParticleSystem:
    def __init__(self) -> None:
        self.particles: List[Particle] = []

    def burst(self, x: float, y: float, color: Tuple[int, int, int],
              count: int = 12, speed: float = 4.0) -> None:
        for _ in range(count):
            ang = random.uniform(0, 2 * math.pi)
            spd = random.uniform(speed * 0.4, speed)
            self.particles.append(Particle(
                x, y,
                math.cos(ang) * spd, math.sin(ang) * spd,
                life=random.uniform(0.25, 0.5),
                color=color,
                size=random.randint(2, 4),
            ))

    def update(self, dt: float) -> None:
        self.particles = [p for p in self.particles if p.update(dt)]

    def draw(self, surface: pygame.Surface) -> None:
        for p in self.particles:
            p.draw(surface)


# ======================================================================
# GAME — the main controller / state machine
# ======================================================================
class Game:
    MENU_ITEMS = ["1 Player (vs AI)", "2 Players", "Leaderboard", "Exit"]

    def __init__(self) -> None:
        pygame.init()
        # Try to set a sensible screen mode; fall back if SCALED isn't supported
        try:
            self.screen = pygame.display.set_mode(
                (SCREEN_WIDTH, SCREEN_HEIGHT), pygame.SCALED, vsync=1
            )
        except Exception:
            self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Purr Pong")
        self.clock = pygame.time.Clock()

        # Fonts
        font_name = pygame.font.match_font(
            "dejavusans,arial,helvetica"
        ) or pygame.font.get_default_font()
        self.font_title = pygame.font.Font(font_name, 88)
        self.font_subtitle = pygame.font.Font(font_name, 22)
        self.font_h1 = pygame.font.Font(font_name, 40)
        self.font_h2 = pygame.font.Font(font_name, 28)
        self.font_body = pygame.font.Font(font_name, 20)
        self.font_small = pygame.font.Font(font_name, 16)
        self.font_huge_score = pygame.font.Font(font_name, 72)
        self.font_popup_title = pygame.font.Font(font_name, 18)
        self.font_popup_desc = pygame.font.Font(font_name, 14)
        self.font_popup_meow = pygame.font.Font(font_name, 14)

        # Background
        self.bg = make_background(SCREEN_WIDTH, SCREEN_HEIGHT)

        # Sound & data
        self.sounds = SoundManager()
        self.leaderboard = Leaderboard(LEADERBOARD_FILE)
        self.achievements = AchievementManager(
            self.sounds,
            self.font_popup_title,
            self.font_popup_desc,
            self.font_popup_meow,
        )

        # State
        self.state = STATE_MENU
        self.menu_index = 0
        self.mode: str = "1P"  # "1P" or "2P"
        self.running = True

        # Game objects (initialised when a match starts)
        self.left_paddle: Optional[Paddle] = None
        self.right_paddle: Optional[Paddle] = None
        self.ball: Optional[Ball] = None
        self.particles = ParticleSystem()

        # Match stats
        self.consecutive_hits = 0  # since last score
        self.max_deficit = 0       # most points the winner was behind by
        self.score_history: List[Tuple[int, int]] = []

        # Name entry
        self.name_buffer = ""
        self.name_winner_score = 0
        self.name_loser_score = 0

        # Title cat bob animation
        self.t = 0.0

    # ------------------------------------------------------------------
    # MATCH LIFECYCLE
    # ------------------------------------------------------------------
    def start_match(self, mode: str) -> None:
        self.mode = mode
        self.left_paddle = Paddle(PADDLE_MARGIN, COLOR_PINK, is_ai=False)
        self.right_paddle = Paddle(
            SCREEN_WIDTH - PADDLE_MARGIN - PADDLE_WIDTH, COLOR_CYAN,
            is_ai=(mode == "1P")
        )
        self.ball = Ball()
        self.consecutive_hits = 0
        self.max_deficit = 0
        self.score_history = []
        self.achievements.reset_run()
        self.state = STATE_PLAYING
        self.sounds.play("menu")

    def end_match(self) -> None:
        left_score = self.left_paddle.score
        right_score = self.right_paddle.score
        winner_score = max(left_score, right_score)
        loser_score = min(left_score, right_score)
        # Flawless Victory: winner conceded 0 points
        if loser_score == 0:
            self.achievements.unlock("flawless")
        # Comeback Kid: winner was down by 5+ at some point
        if self.max_deficit >= ACHV_COMEBACK_DEFICIT:
            self.achievements.unlock("comeback")
        # Play win/lose sound
        self.sounds.play("win")
        # Stash info for the name entry screen
        self.name_winner_score = winner_score
        self.name_loser_score = loser_score
        self.name_buffer = ""
        self.state = STATE_NAME_ENTRY

    # ------------------------------------------------------------------
    # EVENT HANDLING
    # ------------------------------------------------------------------
    def handle_events(self) -> None:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False
                return
            if event.type == pygame.KEYDOWN:
                self._handle_keydown(event.key)
            elif event.type == pygame.MOUSEMOTION:
                self._handle_mouse_motion(event.pos)
            elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                self._handle_mouse_click(event.pos)

    def _handle_keydown(self, key: int) -> None:
        if self.state == STATE_MENU:
            if key in (pygame.K_UP, pygame.K_w):
                self.menu_index = (self.menu_index - 1) % len(self.MENU_ITEMS)
                self.sounds.play("menu")
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.menu_index = (self.menu_index + 1) % len(self.MENU_ITEMS)
                self.sounds.play("menu")
            elif key in (pygame.K_RETURN, pygame.K_SPACE):
                self._activate_menu(self.menu_index)
            elif key == pygame.K_ESCAPE:
                self.running = False

        elif self.state == STATE_PLAYING:
            if key == pygame.K_p:
                self.state = STATE_PAUSED
            elif key == pygame.K_ESCAPE:
                self.state = STATE_MENU

        elif self.state == STATE_PAUSED:
            if key == pygame.K_p:
                self.state = STATE_PLAYING
            elif key == pygame.K_ESCAPE:
                self.state = STATE_MENU

        elif self.state == STATE_GAME_OVER:
            if key == pygame.K_r:
                self.start_match(self.mode)
            elif key in (pygame.K_RETURN, pygame.K_ESCAPE):
                self.state = STATE_MENU

        elif self.state == STATE_NAME_ENTRY:
            if key == pygame.K_RETURN:
                self._submit_name()
            elif key == pygame.K_ESCAPE:
                # Skip name entry, go straight to game-over screen
                self.state = STATE_GAME_OVER
            elif key == pygame.K_BACKSPACE:
                self.name_buffer = self.name_buffer[:-1]
            elif pygame.K_a <= key <= pygame.K_z and len(self.name_buffer) < 10:
                # Add letter (apply shift state via get_pressed)
                mods = pygame.key.get_pressed()
                ch = chr(key)
                if mods[pygame.K_LSHIFT] or mods[pygame.K_RSHIFT]:
                    ch = ch.upper()
                else:
                    ch = ch.upper()  # arcade-style: always uppercase
                self.name_buffer += ch
            elif pygame.K_0 <= key <= pygame.K_9 and len(self.name_buffer) < 10:
                self.name_buffer += str(key - pygame.K_0)

        elif self.state == STATE_LEADERBOARD:
            if key in (pygame.K_ESCAPE, pygame.K_RETURN, pygame.K_SPACE):
                self.state = STATE_MENU

    def _handle_mouse_motion(self, pos) -> None:
        if self.state != STATE_MENU:
            return
        for i, rect in enumerate(self._menu_rects()):
            if rect.collidepoint(pos):
                if self.menu_index != i:
                    self.menu_index = i
                    self.sounds.play("menu")

    def _handle_mouse_click(self, pos) -> None:
        if self.state == STATE_MENU:
            for i, rect in enumerate(self._menu_rects()):
                if rect.collidepoint(pos):
                    self._activate_menu(i)
                    return
        elif self.state == STATE_LEADERBOARD:
            self.state = STATE_MENU
        elif self.state == STATE_GAME_OVER:
            # Click anywhere to restart
            self.start_match(self.mode)

    def _menu_rects(self) -> List[pygame.Rect]:
        rects = []
        base_y = SCREEN_HEIGHT // 2 + 20
        for i in range(len(self.MENU_ITEMS)):
            rects.append(pygame.Rect(
                SCREEN_WIDTH // 2 - 180, base_y + i * 56, 360, 48
            ))
        return rects

    def _activate_menu(self, index: int) -> None:
        self.sounds.play("menu")
        if index == 0:
            self.start_match("1P")
        elif index == 1:
            self.start_match("2P")
        elif index == 2:
            self.state = STATE_LEADERBOARD
        elif index == 3:
            self.running = False

    def _submit_name(self) -> None:
        name = self.name_buffer.strip() or "???"
        self.leaderboard.add(
            name=name,
            score=self.name_winner_score,
            opponent_score=self.name_loser_score,
            mode=self.mode,
        )
        self.state = STATE_GAME_OVER

    # ------------------------------------------------------------------
    # UPDATE
    # ------------------------------------------------------------------
    def update(self, dt: float) -> None:
        self.t += dt
        self.achievements.update(dt)
        self.particles.update(dt)

        if self.state == STATE_PLAYING:
            self._update_play(dt)

    def _update_play(self, dt: float) -> None:
        keys = pygame.key.get_pressed()
        # Player 1 always human
        self.left_paddle.move_player(
            keys[pygame.K_w], keys[pygame.K_s], dt
        )
        # Player 2: human or AI
        if self.right_paddle.is_ai:
            self.right_paddle.move_ai(self.ball, dt)
        else:
            self.right_paddle.move_player(
                keys[pygame.K_UP], keys[pygame.K_DOWN], dt
            )

        # Ball
        event = self.ball.update(dt)
        if event == "wall":
            self.sounds.play("wall")
            self.particles.burst(self.ball.x, self.ball.y, COLOR_PURPLE := (160, 90, 240),
                                 count=8, speed=3.0)

        # Paddle collisions
        self._check_paddle_collision(self.left_paddle)
        self._check_paddle_collision(self.right_paddle)

        # Scoring
        if self.ball.x < -self.ball.size:
            # Right side scores
            self.right_paddle.score += 1
            self._on_score(scored_by="right")
        elif self.ball.x > SCREEN_WIDTH + self.ball.size:
            self.left_paddle.score += 1
            self._on_score(scored_by="left")

        # Track max deficit for Comeback Kid achievement.
        # If the eventual winner was ever behind by 5+, we unlock it at end.
        left, right = self.left_paddle.score, self.right_paddle.score
        leader = max(left, right)
        trailer = min(left, right)
        current_deficit = leader - trailer
        if current_deficit > self.max_deficit:
            # Only count deficit suffered by the player who is currently behind
            # but who might still come back to win.
            self.max_deficit = current_deficit

        # Speed Demon achievement
        if self.ball.speed >= MAX_BALL_SPEED - 0.01:
            self.achievements.unlock("speed_demon")
        # Centurion achievement
        if self.ball.total_hits >= ACHV_CENTURY_HITS:
            self.achievements.unlock("century")

        # Win condition
        if self.left_paddle.score >= WINNING_SCORE or \
           self.right_paddle.score >= WINNING_SCORE:
            self.end_match()

    def _check_paddle_collision(self, paddle: Paddle) -> None:
        if self.ball.frozen:
            return
        ball_rect = pygame.Rect(
            int(self.ball.x - self.ball.size),
            int(self.ball.y - self.ball.size),
            self.ball.size * 2,
            self.ball.size * 2,
        )
        if ball_rect.colliderect(paddle.rect):
            # Make sure the ball is actually moving toward the paddle
            if (paddle.x < SCREEN_WIDTH / 2 and self.ball.vx < 0) or \
               (paddle.x > SCREEN_WIDTH / 2 and self.ball.vx > 0):
                self.ball.bounce_paddle(paddle)
                self.sounds.play("paddle")
                self.particles.burst(
                    self.ball.x, self.ball.y, paddle.color,
                    count=14, speed=4.5
                )
                self.consecutive_hits += 1
                if self.consecutive_hits >= ACHV_CONSECUTIVE_HITS:
                    self.achievements.unlock("unstoppable")

    def _on_score(self, scored_by: str) -> None:
        self.sounds.play("score")
        self.consecutive_hits = 0
        # First Blood achievement: first point scored in the match
        if (self.left_paddle.score + self.right_paddle.score) == 1:
            self.achievements.unlock("first_blood")
        # Reset ball, send it toward the player who just got scored on
        direction = -1 if scored_by == "right" else 1
        self.ball.reset(direction=direction)

    # ------------------------------------------------------------------
    # RENDERING
    # ------------------------------------------------------------------
    def draw(self) -> None:
        self.screen.blit(self.bg, (0, 0))
        if self.state == STATE_MENU:
            self._draw_menu()
        elif self.state in (STATE_PLAYING, STATE_PAUSED):
            self._draw_play()
            if self.state == STATE_PAUSED:
                self._draw_pause_overlay()
        elif self.state == STATE_GAME_OVER:
            self._draw_play()  # show the final frame underneath
            self._draw_game_over()
        elif self.state == STATE_NAME_ENTRY:
            self._draw_play()
            self._draw_name_entry()
        elif self.state == STATE_LEADERBOARD:
            self._draw_leaderboard()
        # Achievements always render on top during play/end screens
        if self.state in (STATE_PLAYING, STATE_PAUSED,
                          STATE_GAME_OVER, STATE_NAME_ENTRY):
            self.achievements.draw(self.screen)
        pygame.display.flip()

    def _draw_menu(self) -> None:
        # Title "PURR PONG" with a bobbing cat face on either side
        bob = math.sin(self.t * 2.5) * 6
        title = self.font_title.render("PURR PONG", True, COLOR_PINK)
        title_rect = title.get_rect(center=(SCREEN_WIDTH // 2, 150 + int(bob)))
        # Subtle glow behind the title
        for off, alpha in [(6, 60), (4, 90), (2, 140)]:
            glow = self.font_title.render("PURR PONG", True, COLOR_CYAN)
            glow.set_alpha(alpha)
            self.screen.blit(glow, glow.get_rect(
                center=(SCREEN_WIDTH // 2 + off, 150 + int(bob) + off)
            ))
        self.screen.blit(title, title_rect)
        # Cat faces flanking the title
        draw_cat_face(self.screen, title_rect.left - 50,
                      title_rect.centery + int(bob), 28, color=COLOR_YELLOW)
        draw_cat_face(self.screen, title_rect.right + 50,
                      title_rect.centery + int(bob), 28, color=COLOR_YELLOW)
        # Subtitle
        sub = self.font_subtitle.render(
            "~ a neon synthwave tribute to 1972 Pong ~", True, COLOR_DIM
        )
        self.screen.blit(sub, sub.get_rect(center=(SCREEN_WIDTH // 2, 210)))

        # Menu items
        for i, label in enumerate(self.MENU_ITEMS):
            rect = self._menu_rects()[i]
            color = COLOR_CYAN if i == self.menu_index else COLOR_WHITE
            # Selection background
            if i == self.menu_index:
                bg = pygame.Surface((rect.width, rect.height), pygame.SRCALPHA)
                bg.fill((60, 30, 100, 180))
                pygame.draw.rect(bg, COLOR_PINK, bg.get_rect(), 2,
                                 border_radius=8)
                self.screen.blit(bg, rect.topleft)
                # Pulsing arrow
                arrow_x = rect.left - 24 + int(math.sin(self.t * 8) * 4)
                pygame.draw.polygon(self.screen, COLOR_PINK, [
                    (arrow_x, rect.centery - 8),
                    (arrow_x + 12, rect.centery),
                    (arrow_x, rect.centery + 8),
                ])
            text = self.font_h2.render(label, True, color)
            self.screen.blit(text, text.get_rect(center=rect.center))

        # Footer hint
        hint = self.font_small.render(
            "Up/Down to navigate • Enter to select • ESC to quit",
            True, COLOR_DIM
        )
        self.screen.blit(hint, hint.get_rect(center=(SCREEN_WIDTH // 2,
                                                     SCREEN_HEIGHT - 28)))

    def _draw_play(self) -> None:
        # Center net
        draw_dashed_line(self.screen, COLOR_NET,
                         SCREEN_WIDTH // 2, 20, SCREEN_HEIGHT - 20,
                         dash=16, gap=14, width=4)
        # Scores
        left_score = self.font_huge_score.render(
            str(self.left_paddle.score), True, COLOR_PINK
        )
        right_score = self.font_huge_score.render(
            str(self.right_paddle.score), True, COLOR_CYAN
        )
        self.screen.blit(left_score, left_score.get_rect(
            center=(SCREEN_WIDTH // 4, 80)))
        self.screen.blit(right_score, right_score.get_rect(
            center=(3 * SCREEN_WIDTH // 4, 80)))
        # Mode label
        mode_label = "1P vs AI" if self.mode == "1P" else "2 Players"
        mode_surf = self.font_small.render(mode_label, True, COLOR_DIM)
        self.screen.blit(mode_surf, mode_surf.get_rect(
            center=(SCREEN_WIDTH // 2, 30)))
        # Win target hint
        target_surf = self.font_small.render(
            f"first to {WINNING_SCORE}", True, COLOR_DIM
        )
        self.screen.blit(target_surf, target_surf.get_rect(
            center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT - 24)))
        # Paddles & ball
        self.left_paddle.draw(self.screen)
        self.right_paddle.draw(self.screen)
        self.ball.draw(self.screen)
        # Particles
        self.particles.draw(self.screen)
        # Center "ready" prompt if ball is frozen
        if self.ball.frozen and self.state == STATE_PLAYING:
            ready = self.font_h2.render("Get ready...", True, COLOR_YELLOW)
            self.screen.blit(ready, ready.get_rect(
                center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 60)))

    def _draw_pause_overlay(self) -> None:
        overlay = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 140))
        self.screen.blit(overlay, (0, 0))
        text = self.font_h1.render("PAUSED", True, COLOR_YELLOW)
        self.screen.blit(text, text.get_rect(
            center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 20)))
        hint = self.font_body.render(
            "P to resume   •   ESC to quit to menu", True, COLOR_WHITE
        )
        self.screen.blit(hint, hint.get_rect(
            center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 30)))

    def _draw_game_over(self) -> None:
        overlay = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 170))
        self.screen.blit(overlay, (0, 0))
        # Determine winner
        ls, rs = self.left_paddle.score, self.right_paddle.score
        if ls > rs:
            winner = "Player 1" if self.mode == "2P" else "You"
            color = COLOR_PINK
        else:
            winner = "AI" if self.mode == "1P" else "Player 2"
            color = COLOR_CYAN
        title = self.font_h1.render(f"{winner} wins!", True, color)
        self.screen.blit(title, title.get_rect(
            center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 70)))
        score = self.font_h2.render(
            f"{ls}  —  {rs}", True, COLOR_WHITE
        )
        self.screen.blit(score, score.get_rect(
            center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 20)))
        hint = self.font_body.render(
            "R to play again   •   ESC for menu   •   click to restart",
            True, COLOR_DIM
        )
        self.screen.blit(hint, hint.get_rect(
            center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 40)))

    def _draw_name_entry(self) -> None:
        overlay = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 190))
        self.screen.blit(overlay, (0, 0))
        # Title
        title = self.font_h1.render("Winner! Enter your name:", True,
                                    COLOR_YELLOW)
        self.screen.blit(title, title.get_rect(
            center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 100)))
        # Score recap
        recap = self.font_h2.render(
            f"Final score: {self.name_winner_score} - {self.name_loser_score}",
            True, COLOR_WHITE
        )
        self.screen.blit(recap, recap.get_rect(
            center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 50)))
        # Name input box
        box = pygame.Rect(SCREEN_WIDTH // 2 - 200, SCREEN_HEIGHT // 2,
                          400, 60)
        pygame.draw.rect(self.screen, COLOR_POPUP_BG, box, border_radius=8)
        pygame.draw.rect(self.screen, COLOR_CYAN, box, 2, border_radius=8)
        # Render name (with cursor)
        cursor = "_" if int(self.t * 2.5) % 2 == 0 else " "
        name_surf = self.font_h2.render(
            self.name_buffer + cursor, True, COLOR_CYAN
        )
        self.screen.blit(name_surf, name_surf.get_rect(center=box.center))
        # Hint
        hint = self.font_body.render(
            "Type letters/numbers • ENTER to save • ESC to skip",
            True, COLOR_DIM
        )
        self.screen.blit(hint, hint.get_rect(
            center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 80)))

    def _draw_leaderboard(self) -> None:
        title = self.font_h1.render("Top 5 Leaderboard", True, COLOR_YELLOW)
        self.screen.blit(title, title.get_rect(
            center=(SCREEN_WIDTH // 2, 90)))
        # Subtitle with cat
        draw_cat_face(self.screen, SCREEN_WIDTH // 2 - 180, 90, 18)
        draw_cat_face(self.screen, SCREEN_WIDTH // 2 + 180, 90, 18)
        entries = self.leaderboard.top(5)
        if not entries:
            msg = self.font_h2.render(
                "No scores yet — be the first to win a match!",
                True, COLOR_DIM
            )
            self.screen.blit(msg, msg.get_rect(
                center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2)))
        else:
            # Header
            header_y = 170
            self.screen.blit(self.font_body.render("#", True, COLOR_CYAN),
                             (SCREEN_WIDTH // 2 - 240, header_y))
            self.screen.blit(self.font_body.render("NAME", True, COLOR_CYAN),
                             (SCREEN_WIDTH // 2 - 200, header_y))
            self.screen.blit(self.font_body.render("SCORE", True, COLOR_CYAN),
                             (SCREEN_WIDTH // 2 - 40, header_y))
            self.screen.blit(self.font_body.render("VS", True, COLOR_CYAN),
                             (SCREEN_WIDTH // 2 + 60, header_y))
            self.screen.blit(self.font_body.render("MODE", True, COLOR_CYAN),
                             (SCREEN_WIDTH // 2 + 120, header_y))
            self.screen.blit(self.font_body.render("DATE", True, COLOR_CYAN),
                             (SCREEN_WIDTH // 2 + 200, header_y))
            pygame.draw.line(self.screen, COLOR_NET,
                             (SCREEN_WIDTH // 2 - 250, header_y + 24),
                             (SCREEN_WIDTH // 2 + 250, header_y + 24), 2)
            # Rows
            for i, e in enumerate(entries):
                y = header_y + 40 + i * 40
                medal_colors = [COLOR_YELLOW, COLOR_WHITE, (205, 127, 50),
                                COLOR_DIM, COLOR_DIM]
                color = medal_colors[i] if i < len(medal_colors) else COLOR_DIM
                self.screen.blit(self.font_body.render(str(i + 1), True, color),
                                 (SCREEN_WIDTH // 2 - 240, y))
                self.screen.blit(self.font_body.render(e["name"], True, color),
                                 (SCREEN_WIDTH // 2 - 200, y))
                self.screen.blit(self.font_body.render(str(e["score"]), True, color),
                                 (SCREEN_WIDTH // 2 - 40, y))
                self.screen.blit(self.font_body.render(str(e["opponent"]), True, color),
                                 (SCREEN_WIDTH // 2 + 60, y))
                self.screen.blit(self.font_body.render(e.get("mode", "?"), True, color),
                                 (SCREEN_WIDTH // 2 + 120, y))
                self.screen.blit(self.font_small.render(e.get("date", ""), True, color),
                                 (SCREEN_WIDTH // 2 + 200, y))
        # Hint
        hint = self.font_body.render(
            "ESC / ENTER / click to return to menu", True, COLOR_DIM
        )
        self.screen.blit(hint, hint.get_rect(
            center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT - 40)))

    # ------------------------------------------------------------------
    # MAIN LOOP
    # ------------------------------------------------------------------
    def run(self) -> None:
        try:
            while self.running:
                dt = min(self.clock.tick(FPS) / 1000.0, 1 / 30)
                self.handle_events()
                self.update(dt)
                self.draw()
        except KeyboardInterrupt:
            pass
        finally:
            pygame.quit()


# ======================================================================
# ENTRY POINT
# ======================================================================
def main() -> None:
    Game().run()


if __name__ == "__main__":
    main()
