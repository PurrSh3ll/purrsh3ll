"""
Purr Volleyball
===============
A neon synthwave take on classic Blobby Volleyball, featuring glowing
cat-blob characters, procedural audio, achievements, and a persistent
leaderboard. Single-file, no external assets required.

Controls
--------
Player 1 (left, cyan):   A / D to move, W to jump
Player 2 (right, pink):  Arrow Left / Right to move, Arrow Up to jump
                         (or AI in 1-player mode)

Menu navigation
---------------
UP / DOWN to highlight, ENTER to confirm.
ESC to pause / go back. M to mute. R to toggle reduced motion.

Install
-------
    pip install pygame

Run
---
    python purr_volleyball.py
"""

from __future__ import annotations

import os
import sys
import math
import json
import random
import datetime
from array import array
from typing import Optional, List, Tuple, Callable

try:
    import pygame
    from pygame import gfxdraw
except ImportError:  # pragma: no cover
    print("Pygame is required. Install with:  pip install pygame")
    sys.exit(1)


# =============================================================================
# CONFIG
# =============================================================================
WIDTH, HEIGHT        = 1024, 640
FPS                  = 60
GRAVITY              = 0.55
GROUND_Y             = HEIGHT - 90
NET_HEIGHT           = 150
NET_X                = WIDTH // 2
NET_TOP_Y            = GROUND_Y - NET_HEIGHT
WINNING_SCORE        = 11
MAX_TOUCHES          = 3
BALL_RADIUS          = 26   # was 20 — bigger ball, easier to hit
BLOB_RADIUS          = 48
BLOB_W_RATIO         = 0.85   # blobs are narrow + tall (vertical longitudinal)
BLOB_H_RATIO         = 1.35
BLOB_SPEED           = 10.5  # was 8.4 — even faster, snappier movement
BLOB_JUMP_V          = -14.5
BALL_RESTITUTION     = 0.92
NET_RESTITUTION      = 0.78
WALL_RESTITUTION     = 0.85

# Neon palette — DARK purple background, high-contrast foreground
COL_SKY_TOP   = (8, 2, 22)      # very dark indigo (near black)
COL_SKY_MID   = (18, 6, 42)      # dark purple
COL_SKY_BOT   = (28, 8, 55)      # slightly lighter purple at horizon
COL_SUN_HOT   = (255, 140, 60)
COL_SUN_COOL  = (140, 30, 90)
COL_GRID      = (90, 25, 130)    # dim purple grid (was bright magenta)
COL_GRID_FAR  = (40, 12, 70)
COL_NET       = (200, 60, 230)
COL_NET_GLOW  = (120, 30, 160)
COL_BALL      = (255, 255, 240)  # near-white for max contrast
COL_BALL_GLOW = (255, 200, 80)
COL_P1        = (40, 220, 255)   # electric cyan
COL_P2        = (255, 80, 110)   # crimson
COL_TEXT      = (245, 245, 255)
COL_TEXT_GLOW = (150, 80, 255)
COL_ACCENT    = (255, 210, 90)
COL_DANGER    = (255, 80, 80)

LEADERBOARD_FILE = "volleyball_leaderboard.json"
SCRIPT_DIR       = os.path.dirname(os.path.abspath(__file__))
LEADERBOARD_PATH = os.path.join(SCRIPT_DIR, LEADERBOARD_FILE)


# =============================================================================
# MATH HELPERS
# =============================================================================
def clamp(v: float, lo: float, hi: float) -> float:
    return lo if v < lo else hi if v > hi else v


def lerp(a: float, b: float, t: float) -> float:
    return a + (b - a) * t


def ease_out_cubic(t: float) -> float:
    return 1 - (1 - t) ** 3


# =============================================================================
# PROCEDURAL ASSET HELPERS
# =============================================================================
_glow_cache: dict = {}

def make_glow_surface(radius: int, color: Tuple[int, int, int],
                      intensity: float = 1.0) -> pygame.Surface:
    """Cached radial-gradient surface used for neon glow halos."""
    key = (radius, color, round(intensity, 2))
    if key in _glow_cache:
        return _glow_cache[key]
    size = radius * 2
    surf = pygame.Surface((size, size), pygame.SRCALPHA)
    for r in range(radius, 0, -1):
        t = r / radius
        alpha = int(255 * (1 - t) ** 2 * intensity)
        alpha = max(0, min(255, alpha))
        pygame.draw.circle(surf, (*color, alpha), (radius, radius), r)
    _glow_cache[key] = surf
    return surf


def blit_glow(target: pygame.Surface, color: Tuple[int, int, int],
              pos: Tuple[int, int], radius: int, intensity: float = 1.0,
              additive: bool = True) -> None:
    """Convenience wrapper to blit a cached glow halo centered on pos."""
    g = make_glow_surface(radius, color, intensity)
    flags = pygame.BLEND_RGBA_ADD if additive else 0
    target.blit(g, (pos[0] - radius, pos[1] - radius), special_flags=flags)


def make_background(width: int, height: int) -> pygame.Surface:
    """Pre-render the synthwave sky + sun + perspective grid."""
    surf = pygame.Surface((width, height)).convert()

    # --- Sky gradient (vertical) ---
    horizon = GROUND_Y
    for y in range(0, horizon):
        t = y / horizon
        if t < 0.55:
            tt = t / 0.55
            r = int(lerp(COL_SKY_TOP[0], COL_SKY_MID[0], tt))
            g = int(lerp(COL_SKY_TOP[1], COL_SKY_MID[1], tt))
            b = int(lerp(COL_SKY_TOP[2], COL_SKY_MID[2], tt))
        else:
            tt = (t - 0.55) / 0.45
            r = int(lerp(COL_SKY_MID[0], COL_SKY_BOT[0], tt))
            g = int(lerp(COL_SKY_MID[1], COL_SKY_BOT[1], tt))
            b = int(lerp(COL_SKY_MID[2], COL_SKY_BOT[2], tt))
        pygame.draw.line(surf, (r, g, b), (0, y), (width, y))

    # --- Perspective grid floor ---
    floor_rect = pygame.Rect(0, horizon, width, height - horizon)
    # Very-dark purple fill below horizon (keeps the floor from glowing)
    pygame.draw.rect(surf, (8, 3, 22), floor_rect)
    # Horizontal grid lines (perspective: lines get closer toward horizon)
    n_lines = 18
    for i in range(1, n_lines + 1):
        t = i / n_lines
        y = horizon + (height - horizon) * (t ** 2)
        alpha = int(255 * t * 0.9)
        col = (COL_GRID[0], COL_GRID[1], COL_GRID[2])
        pygame.draw.line(surf, col, (0, y), (width, y), 1)
    # Vertical grid lines converging to vanishing point
    vp_x, vp_y = width // 2, horizon
    n_vert = 24
    for i in range(-n_vert, n_vert + 1):
        x_bot = width // 2 + i * (width // n_vert)
        pygame.draw.line(surf, COL_GRID, (x_bot, height), (vp_x, vp_y), 1)

    # --- Stars in the upper sky ---
    rng = random.Random(7)
    for _ in range(80):
        sx = rng.randint(0, width)
        sy = rng.randint(0, horizon - 60)
        b = rng.randint(120, 255)
        pygame.draw.circle(surf, (b, b, 255), (sx, sy), rng.choice([1, 1, 1, 2]))

    # Subtle court boundary line (thin cyan, no huge glow that would
    # otherwise wash the whole sky blue via additive blending).
    pygame.draw.line(surf, (120, 200, 255), (0, GROUND_Y), (width, GROUND_Y), 2)

    return surf


# =============================================================================
# AUDIO ENGINE (procedural SFX + looping synthwave bassline)
# =============================================================================
class AudioEngine:
    """Generates and plays procedural retro SFX and a synthwave bassline.

    All audio is generated at runtime from primitive waveforms so the game
    needs zero external assets. If the mixer cannot initialise (e.g. headless
    box or no audio device), `enabled` stays False and every call becomes a
    no-op — the game still runs perfectly.
    """

    def __init__(self) -> None:
        self.enabled: bool = False
        self.muted: bool = False
        self.sounds: dict = {}
        self.bass_loop: Optional[pygame.mixer.Sound] = None
        self.music_channel: Optional[pygame.mixer.Channel] = None
        try:
            pygame.mixer.pre_init(44100, -16, 2, 256)
            pygame.mixer.init()
            self.enabled = True
            self._generate_all()
        except Exception as e:  # pragma: no cover - depends on host audio
            print(f"[AudioEngine] Audio disabled: {e}")
            self.enabled = False

    # ------------------------------------------------------------------
    @staticmethod
    def _to_sound(mono_samples: List[float]) -> Optional[pygame.mixer.Sound]:
        """Convert mono float [-1,1] samples to a stereo 16-bit Sound."""
        try:
            arr = array('h')
            for s in mono_samples:
                v = max(-1.0, min(1.0, s))
                iv = int(v * 32767)
                arr.append(iv)  # L
                arr.append(iv)  # R
            return pygame.mixer.Sound(buffer=arr.tobytes())
        except Exception as e:
            print(f"[AudioEngine] sound build failed: {e}")
            return None

    def _generate_all(self) -> None:
        SR = 44100

        # --- Jump: quick rising sweep ---
        jump: List[float] = []
        dur = 0.18
        for i in range(int(SR * dur)):
            t = i / SR
            freq = 320 + 900 * t / dur
            env = math.exp(-4 * t)
            jump.append(env * 0.45 * math.sin(2 * math.pi * freq * t))
        self.sounds['jump'] = self._to_sound(jump)

        # --- Hit: punchy thump + high tick ---
        hit: List[float] = []
        dur = 0.14
        for i in range(int(SR * dur)):
            t = i / SR
            freq = max(60, 240 - 1200 * t / dur)
            env = math.exp(-10 * t)
            hit.append(env * 0.55 * math.sin(2 * math.pi * freq * t))
        self.sounds['hit'] = self._to_sound(hit)

        # --- Net hit: high metallic tick ---
        net: List[float] = []
        dur = 0.09
        for i in range(int(SR * dur)):
            t = i / SR
            env = math.exp(-30 * t)
            s = (math.sin(2 * math.pi * 1100 * t) +
                 0.4 * math.sin(2 * math.pi * 1750 * t))
            net.append(env * 0.35 * s)
        self.sounds['net'] = self._to_sound(net)

        # --- Score: ascending arpeggio chord ---
        score: List[float] = []
        dur = 0.6
        freqs = [523.25, 659.25, 783.99, 1046.5]  # C5 E5 G5 C6
        step = dur / len(freqs)
        for i in range(int(SR * dur)):
            t = i / SR
            idx = min(int(t / step), len(freqs) - 1)
            local_t = t - idx * step
            env = math.exp(-2.5 * local_t) * (1 - math.exp(-40 * local_t))
            f = freqs[idx]
            score.append(env * 0.4 * math.sin(2 * math.pi * f * t))
        self.sounds['score'] = self._to_sound(score)

        # --- Lose point: descending sad ---
        lose: List[float] = []
        dur = 0.5
        for i in range(int(SR * dur)):
            t = i / SR
            freq = max(80, 400 - 600 * t / dur)
            env = math.exp(-3 * t)
            lose.append(env * 0.35 * math.sin(2 * math.pi * freq * t))
        self.sounds['lose'] = self._to_sound(lose)

        # --- Achievement: sparkle ---
        achv: List[float] = []
        dur = 0.45
        for i in range(int(SR * dur)):
            t = i / SR
            env = math.exp(-3 * t) * (1 - math.exp(-30 * t))
            f = 880 + 1200 * t / dur
            achv.append(env * 0.35 * math.sin(2 * math.pi * f * t))
        self.sounds['achv'] = self._to_sound(achv)

        # --- Synthwave bassline loop (8 beats, ~100 BPM) ---
        bass: List[float] = []
        bpm = 100
        beat = 60.0 / bpm
        total_beats = 8
        total = beat * total_beats
        # Notes: A1, A1, E2, A1, C2, A1, D2, E2 (loose vamp)
        notes = [55.0, 55.0, 82.41, 55.0, 65.41, 55.0, 73.42, 82.41]
        for i in range(int(SR * total)):
            t = i / SR
            beat_idx = int(t / beat) % total_beats
            local_t = t - int(t / beat) * beat
            f = notes[beat_idx]
            env = math.exp(-3.2 * local_t / beat)
            wave = (math.sin(2 * math.pi * f * t) +
                    0.45 * math.sin(2 * math.pi * f * 2 * t) +
                    0.18 * math.sin(2 * math.pi * f * 3 * t))
            bass.append(env * wave * 0.22)
        # Soft pad layer (slow sine on root)
        for i in range(int(SR * total)):
            t = i / SR
            pad = 0.08 * math.sin(2 * math.pi * 27.5 * t) * (0.5 + 0.5 * math.sin(2 * math.pi * 0.5 * t))
            bass[i] += pad
        self.bass_loop = self._to_sound(bass)
        if self.bass_loop:
            self.bass_loop.set_volume(0.35)

    # ------------------------------------------------------------------
    def play(self, name: str, volume: float = 0.6) -> None:
        if not self.enabled or self.muted:
            return
        snd = self.sounds.get(name)
        if snd is None:
            return
        try:
            snd.set_volume(volume)
            snd.play()
        except Exception as e:
            print(f"[AudioEngine] play('{name}') error: {e}")

    def start_music(self) -> None:
        if not self.enabled or self.muted or not self.bass_loop:
            return
        try:
            if self.music_channel and self.music_channel.get_busy():
                return
            self.music_channel = self.bass_loop.play(loops=-1)
        except Exception as e:
            print(f"[AudioEngine] music start error: {e}")

    def stop_music(self) -> None:
        if self.music_channel:
            try:
                self.music_channel.stop()
            except Exception:
                pass
            self.music_channel = None

    def set_muted(self, muted: bool) -> None:
        self.muted = muted
        if muted:
            self.stop_music()
        else:
            self.start_music()


# =============================================================================
# PARTICLE SYSTEM (neon trails + impact bursts)
# =============================================================================
class Particle:
    __slots__ = ('x', 'y', 'vx', 'vy', 'life', 'max_life', 'color', 'size')

    def __init__(self, x: float, y: float, vx: float, vy: float,
                 life: float, color: Tuple[int, int, int], size: float) -> None:
        self.x = x; self.y = y
        self.vx = vx; self.vy = vy
        self.life = life; self.max_life = life
        self.color = color
        self.size = size

    def update(self, dt: float) -> bool:
        self.life -= dt
        if self.life <= 0:
            return False
        self.x += self.vx * dt * 60
        self.y += self.vy * dt * 60
        self.vy += 0.18
        self.vx *= 0.97
        return True

    def draw(self, surf: pygame.Surface) -> None:
        t = self.life / self.max_life
        size = max(1, int(self.size * t))
        alpha = int(255 * t)
        blit_glow(surf, self.color, (int(self.x), int(self.y)),
                  size * 3, t * 0.8)
        try:
            gfxdraw.filled_circle(surf, int(self.x), int(self.y), size,
                                  (*self.color, alpha))
        except Exception:
            pygame.draw.circle(surf, self.color, (int(self.x), int(self.y)), size)


class ParticleSystem:
    def __init__(self) -> None:
        self.particles: List[Particle] = []

    def emit_trail(self, x: float, y: float, color: Tuple[int, int, int],
                   vx: float = 0, vy: float = 0, count: int = 1) -> None:
        for _ in range(count):
            self.particles.append(Particle(
                x, y,
                vx + random.uniform(-0.5, 0.5),
                vy + random.uniform(-0.5, 0.5),
                life=random.uniform(0.25, 0.5),
                color=color,
                size=random.uniform(2, 4),
            ))

    def emit_burst(self, x: float, y: float, color: Tuple[int, int, int],
                   count: int = 18, speed: float = 4.0) -> None:
        for _ in range(count):
            ang = random.uniform(0, math.tau)
            spd = random.uniform(speed * 0.4, speed)
            self.particles.append(Particle(
                x, y,
                math.cos(ang) * spd,
                math.sin(ang) * spd - 1.0,
                life=random.uniform(0.35, 0.7),
                color=color,
                size=random.uniform(2.5, 5),
            ))

    def update(self, dt: float) -> None:
        self.particles = [p for p in self.particles if p.update(dt)]

    def draw(self, surf: pygame.Surface) -> None:
        for p in self.particles:
            p.draw(surf)

    def clear(self) -> None:
        self.particles.clear()


# =============================================================================
# CAT BLOB (player character)
# =============================================================================
class CatBlob:
    """A bouncy half-dome cat blob with glowing triangle ears and big eyes.

    Visual shape: a half-ellipse sitting on the ground (flat side down),
    like classic Blobby Volleyball slimes. The body squishes on landing
    and on impact with the ball for arcade feel.
    """

    def __init__(self, x: float, color: Tuple[int, int, int],
                 facing: int, is_ai: bool = False) -> None:
        self.x: float = x
        self.y: float = GROUND_Y
        self.vx: float = 0.0
        self.vy: float = 0.0
        self.radius: int = BLOB_RADIUS
        self.color = color
        self.facing = facing  # +1 = right side of court, -1 = left side
        self.is_ai = is_ai
        self.on_ground = True
        # Squish deformation (1.0 = rest). Squishes horizontally when jumping,
        # vertically when landing.
        self.squish_x = 1.0
        self.squish_y = 1.0
        self.squish_vx = 0.0
        self.squish_vy = 0.0
        # Eye blink
        self.blink_t = random.uniform(2.0, 5.0)
        self.blinking = 0.0
        # Tail flick
        self.tail_phase = random.uniform(0, math.tau)

    # ------------------------------------------------------------------
    @property
    def center(self) -> Tuple[float, float]:
        """Collision centre.

        The visible body is a longitudinal half-dome (wider than tall, like
        classic Blobby Volleyball slimes). The collision circle is centred
        at the geometric middle of that dome so hits feel natural.
        """
        body_h = self.radius * 2 * BLOB_H_RATIO
        return (self.x, self.y - body_h * 0.5)

    def jump(self) -> bool:
        if self.on_ground:
            self.vy = BLOB_JUMP_V
            self.on_ground = False
            # Stretch vertically on takeoff
            self.squish_vy = 0.35
            self.squish_vx = -0.18
            return True
        return False

    def update(self, dt: float, move_dir: int, jump_held: bool) -> Optional[str]:
        """move_dir: -1 left, 0 idle, +1 right. Returns 'jump' event string."""
        event: Optional[str] = None

        # Horizontal movement
        if move_dir != 0:
            self.vx = move_dir * BLOB_SPEED
        else:
            self.vx *= 0.72
            if abs(self.vx) < 0.1:
                self.vx = 0.0

        # Jump
        if jump_held and self.on_ground:
            if self.jump():
                event = 'jump'

        # Gravity
        self.vy += GRAVITY
        self.x += self.vx
        self.y += self.vy

        # Ground collision
        if self.y >= GROUND_Y:
            self.y = GROUND_Y
            if self.vy > 4.0:
                # Landing squish
                self.squish_vy = -0.45
                self.squish_vx = 0.25
            self.vy = 0.0
            self.on_ground = True

        # Side constraint (each blob stays on its own half).
        # Use the body's actual half-width so the wider longitudinal shape
        # never visually clips through the net.
        half_w = self.radius * BLOB_W_RATIO
        if self.facing == -1:  # left player
            self.x = clamp(self.x, half_w + 4, NET_X - half_w - 6)
        else:                   # right player
            self.x = clamp(self.x, NET_X + half_w + 6, WIDTH - half_w - 4)

        # Spring-back squish physics
        # squish_x and squish_y oscillate back toward 1.0
        self.squish_vx += -0.6 * (self.squish_x - 1.0)
        self.squish_vy += -0.6 * (self.squish_y - 1.0)
        self.squish_vx *= 0.82
        self.squish_vy *= 0.82
        self.squish_x += self.squish_vx
        self.squish_y += self.squish_vy

        # Blink
        self.blink_t -= dt
        if self.blink_t <= 0:
            self.blinking = 0.12
            self.blink_t = random.uniform(2.5, 6.0)
        if self.blinking > 0:
            self.blinking -= dt

        # Tail
        self.tail_phase += dt * 6.0

        return event

    # ------------------------------------------------------------------
    def draw(self, surf: pygame.Surface) -> None:
        """Draw a plain neon blobby slime (half-ellipse dome, no cat features)."""
        sq_x = clamp(self.squish_x, 0.7, 1.3)
        sq_y = clamp(self.squish_y, 0.7, 1.3)
        # Longitudinal body: wider than tall (classic Blobby slime shape)
        body_w = int(self.radius * 2 * BLOB_W_RATIO * sq_x)
        body_h = int(self.radius * 2 * BLOB_H_RATIO * sq_y)
        # Half-dome rect: top is `body_h` tall, bottom touches self.y
        rect = pygame.Rect(0, 0, body_w, body_h)
        rect.midbottom = (int(self.x), int(self.y))

        cx, cy = rect.center

        # Outer glow halo — shaped to match the longitudinal body (tall +
        # narrow), not a wide circle. We render a circular glow and then
        # squash it to the body's aspect ratio so the halo doesn't stick
        # out past the blob's actual silhouette.
        glow_r = int(self.radius * 1.4)
        g = make_glow_surface(glow_r, self.color, 0.65)
        # Scale to the body's aspect ratio (slightly larger than the body
        # so the halo hugs the silhouette without bulging sideways).
        gw = int(body_w * 1.25)
        gh = int(body_h * 1.25)
        g_scaled = pygame.transform.smoothscale(g, (gw, gh))
        surf.blit(g_scaled,
                  (cx - gw // 2, cy - gh // 2),
                  special_flags=pygame.BLEND_RGBA_ADD)

        # Body: half-ellipse dome (full ellipse drawn, lower half hangs
        # below the visible dome but reads fine because it overlaps the
        # floor and is the same color family).
        body_surf = pygame.Surface((body_w, body_h), pygame.SRCALPHA)
        pygame.draw.ellipse(body_surf, self.color, body_surf.get_rect())
        # Inner highlight (lighter top-left, gives a glossy jelly feel)
        highlight_col = tuple(min(255, c + 70) for c in self.color)
        hi_rect = pygame.Rect(int(body_w * 0.10), int(body_h * 0.08),
                              int(body_w * 0.50), int(body_h * 0.50))
        pygame.draw.ellipse(body_surf, (*highlight_col, 110), hi_rect)
        # Subtle darker shadow at the bottom rim
        shadow_col = tuple(max(0, c - 50) for c in self.color)
        sh_rect = pygame.Rect(int(body_w * 0.10), int(body_h * 0.65),
                              int(body_w * 0.80), int(body_h * 0.30))
        pygame.draw.ellipse(body_surf, (*shadow_col, 90), sh_rect)
        # Thin bright outline (was width 2 — too thick; 1 hugs the
        # longitudinal silhouette cleanly).
        pygame.draw.ellipse(body_surf, (255, 255, 255),
                            body_surf.get_rect(), 1)
        surf.blit(body_surf, rect.topleft)

        # Small facing indicator (a tiny notch on the front of the dome)
        # so the player can tell which way each blob is "looking".
        # Just a small dot — no glow halo (keeps the silhouette clean).
        notch_x = cx + self.facing * int(body_w * 0.35)
        notch_y = rect.top + int(body_h * 0.18)
        pygame.draw.circle(surf, (255, 255, 255), (notch_x, notch_y), 3)
        pygame.draw.circle(surf, self.color, (notch_x, notch_y), 3, 1)


# =============================================================================
# BALL
# =============================================================================
class Ball:
    def __init__(self) -> None:
        self.x: float = 0.0
        self.y: float = 0.0
        self.vx: float = 0.0
        self.vy: float = 0.0
        self.radius: int = BALL_RADIUS
        self.last_side: int = 0  # -1 left, +1 right, 0 none
        self.last_hit_by: Optional[int] = None  # 1 or 2
        self.touched_by_p1: int = 0
        self.touched_by_p2: int = 0
        self.frozen: bool = True   # frozen during serve countdown
        self.spin: float = 0.0
        self.trail: List[Tuple[float, float]] = []

    def reset(self, side: int) -> None:
        """Place ball above the player who is about to serve."""
        self.vx = 0.0
        self.vy = 0.0
        self.spin = 0.0
        self.touched_by_p1 = 0
        self.touched_by_p2 = 0
        self.last_hit_by = None
        self.last_side = side
        if side == -1:
            self.x = 200
        else:
            self.x = WIDTH - 200
        self.y = 120
        self.frozen = True
        self.trail.clear()

    def update(self, dt: float) -> None:
        if self.frozen:
            return
        self.vy += GRAVITY * 0.9
        # Air friction
        self.vx *= 0.998
        self.x += self.vx
        self.y += self.vy
        self.spin += self.vx * 0.05

        # Side walls
        if self.x - self.radius < 0:
            self.x = self.radius
            self.vx = -self.vx * WALL_RESTITUTION
        elif self.x + self.radius > WIDTH:
            self.x = WIDTH - self.radius
            self.vx = -self.vx * WALL_RESTITUTION

        # Ceiling
        if self.y - self.radius < 0:
            self.y = self.radius
            self.vy = -self.vy * WALL_RESTITUTION

        # Trail
        self.trail.append((self.x, self.y))
        if len(self.trail) > 10:
            self.trail.pop(0)

    def draw(self, surf: pygame.Surface) -> None:
        # --- Trail (dim, small) ---
        for i, (tx, ty) in enumerate(self.trail):
            t = (i + 1) / len(self.trail)
            r = max(2, int(self.radius * t * 0.5))
            blit_glow(surf, COL_BALL_GLOW, (int(tx), int(ty)),
                      r * 2, t * 0.35)

        cx, cy = int(self.x), int(self.y)
        R = self.radius

        # --- Small outer glow (was radius*3 at 0.9 — too big; now snug) ---
        blit_glow(surf, COL_BALL_GLOW, (cx, cy), int(R * 1.5), 0.45)

        # --- Body ---
        pygame.draw.circle(surf, COL_BALL, (cx, cy), R)

        # --- Volleyball panel pattern ---
        # A real volleyball has curved seams dividing the surface into 6
        # panels. We approximate this with three curved "petal" arcs that
        # rotate with the ball's spin. Each arc is drawn as a series of
        # short line segments along a great-circle-like curve.
        seam_col = (90, 60, 20)  # dark brown-gold seam
        ang = self.spin
        n_petals = 3
        for k in range(n_petals):
            base_a = ang + k * (math.tau / n_petals)
            # Each petal is a curve from one edge, dipping toward the
            # center, and out the opposite edge — like a volleyball seam.
            pts = []
            steps = 18
            for s in range(steps + 1):
                tt = s / steps  # 0..1
                # Parametric curve: travels across the ball, dipping
                # toward center. u goes -1..+1 across the ball.
                u = (tt * 2 - 1)
                # Direction of travel across the ball
                dx = math.cos(base_a)
                dy = math.sin(base_a)
                # Perpendicular offset (the "dip")
                px = -math.sin(base_a)
                py = math.cos(base_a)
                # The seam dips toward center: max dip at u=0
                dip = math.cos(u * math.pi * 0.5) * 0.55
                # Point on the ball surface (projected to 2D)
                sx = cx + (u * dx + dip * px) * R * 0.95
                sy = cy + (u * dy + dip * py) * R * 0.95
                pts.append((sx, sy))
            if len(pts) >= 2:
                pygame.draw.lines(surf, seam_col, False, pts, 2)

        # --- Equator seam (subtle horizontal great circle) ---
        equator_pts = []
        for s in range(25):
            tt = s / 24
            a = tt * math.tau + ang * 0.5
            # Ellipse to fake the perspective of a great circle
            ex = cx + math.cos(a) * R * 0.97
            ey = cy + math.sin(a) * R * 0.25
            equator_pts.append((ex, ey))
        if len(equator_pts) >= 2:
            pygame.draw.lines(surf, seam_col, False, equator_pts, 1)

        # --- Soft highlight (glossy sphere look) ---
        hl_r = max(2, R // 3)
        hl_surf = pygame.Surface((hl_r * 4, hl_r * 4), pygame.SRCALPHA)
        for r in range(hl_r, 0, -1):
            alpha = int(180 * (1 - r / hl_r) ** 1.5)
            pygame.draw.circle(hl_surf, (255, 255, 240, alpha),
                               (hl_r * 2, hl_r * 2), r)
        surf.blit(hl_surf,
                  (cx - int(R * 0.45) - hl_r * 2,
                   cy - int(R * 0.45) - hl_r * 2))

        # --- Thin outline (was white width 1, keep it subtle) ---
        pygame.draw.circle(surf, (200, 180, 100), (cx, cy), R, 1)


# =============================================================================
# NET
# =============================================================================
class Net:
    """A glowing vertical neon net. Collision = a thin rectangle in the middle."""

    def __init__(self) -> None:
        self.x = NET_X
        self.top_y = NET_TOP_Y
        self.bottom_y = GROUND_Y
        self.thickness = 6
        self.rect = pygame.Rect(self.x - self.thickness // 2,
                                self.top_y,
                                self.thickness,
                                self.bottom_y - self.top_y)

    def draw(self, surf: pygame.Surface) -> None:
        # Glow halo along the whole net
        for r in (24, 16, 10):
            glow = pygame.Surface((r * 2, self.rect.height + r * 2),
                                  pygame.SRCALPHA)
            pygame.draw.rect(glow, (*COL_NET_GLOW, 30),
                             glow.get_rect(), border_radius=r)
            surf.blit(glow, (self.rect.centerx - r, self.rect.top - r),
                      special_flags=pygame.BLEND_RGBA_ADD)
        # Main shaft
        pygame.draw.rect(surf, COL_NET, self.rect)
        # Highlight stripe
        inner = self.rect.copy()
        inner.x += 1
        inner.width = 2
        pygame.draw.rect(surf, (255, 220, 255), inner)
        # Cap knob at the top
        cap_r = 9
        blit_glow(surf, COL_NET, (self.x, self.top_y), cap_r * 3, 0.9)
        pygame.draw.circle(surf, COL_NET, (self.x, self.top_y), cap_r)
        pygame.draw.circle(surf, (255, 255, 255), (self.x, self.top_y), cap_r, 1)
        # Cap knob at the bottom (anchor)
        pygame.draw.circle(surf, COL_NET, (self.x, self.bottom_y), 6)


# =============================================================================
# ACHIEVEMENTS
# =============================================================================
class Achievement:
    def __init__(self, key: str, title: str, desc: str,
                 icon: str = "*") -> None:
        self.key = key
        self.title = title
        self.desc = desc
        self.icon = icon


ACHIEVEMENTS: List[Achievement] = [
    Achievement("ace",       "Purr-fect Placement", "Ace serve — opponent never touched it!", "*"),
    Achievement("ninelives", "Nine Lives",          "Saved the ball millimetres from the floor.", "+"),
    Achievement("megasmash", "Mega Smash",          "Hit the ball at extreme velocity!", "#"),
    Achievement("combo",     "Combo Cat",           "Three clean touches in one rally.", "="),
    Achievement("firstblood","First Blood",         "Scored the first point of the match.", "1"),
    Achievement("claw",      "Claw Machine",        "Won the match by 5+ points.", ">"),
    Achievement("comeback",  "Cat Comeback",        "Won after being 5+ points behind.", "<"),
    Achievement("wallcat",   "Wall Cat",            "Survived 20+ rallies in a single match.", "W"),
]


class AchievementPopup:
    def __init__(self, achv: Achievement) -> None:
        self.achv = achv
        self.life = 4.0
        self.max_life = 4.0

    def update(self, dt: float) -> bool:
        self.life -= dt
        return self.life > 0

    def draw(self, surf: pygame.Surface, font_title: pygame.font.Font,
             font_desc: pygame.font.Font, y_offset: int) -> None:
        # Easing: slide in / out
        t = 1.0 - (self.life / self.max_life)
        if t < 0.15:
            slide = ease_out_cubic(t / 0.15)
        elif t > 0.85:
            slide = 1.0 - ease_out_cubic((t - 0.85) / 0.15)
        else:
            slide = 1.0
        x_target = WIDTH - 360
        x = lerp(WIDTH, x_target, slide)
        y = 20 + y_offset
        w, h = 340, 80
        rect = pygame.Rect(int(x), int(y), w, h)
        # Glow
        blit_glow(surf, COL_ACCENT, rect.center, 80, 0.5)
        # Card
        card = pygame.Surface((w, h), pygame.SRCALPHA)
        pygame.draw.rect(card, (20, 10, 50, 230), card.get_rect(),
                         border_radius=12)
        pygame.draw.rect(card, COL_ACCENT, card.get_rect(), 2,
                         border_radius=12)
        surf.blit(card, rect.topleft)
        # Icon
        icon_font = pygame.font.SysFont("dejavusans,arial", 32, bold=True)
        icon = icon_font.render(self.achv.icon, True, COL_ACCENT)
        surf.blit(icon, (rect.x + 14, rect.y + 18))
        # Title
        title_s = font_title.render(self.achv.title, True, COL_ACCENT)
        surf.blit(title_s, (rect.x + 60, rect.y + 10))
        # Desc
        desc_s = font_desc.render(self.achv.desc, True, COL_TEXT)
        surf.blit(desc_s, (rect.x + 60, rect.y + 40))


class AchievementManager:
    def __init__(self, audio: AudioEngine) -> None:
        self.audio = audio
        self.unlocked: set = set()
        self.popups: List[AchievementPopup] = []

    def unlock(self, key: str) -> None:
        if key in self.unlocked:
            return
        for a in ACHIEVEMENTS:
            if a.key == key:
                self.unlocked.add(key)
                self.popups.append(AchievementPopup(a))
                self.audio.play('achv', 0.5)
                return

    def update(self, dt: float) -> None:
        self.popups = [p for p in self.popups if p.update(dt)]

    def draw(self, surf: pygame.Surface, font_title: pygame.font.Font,
             font_desc: pygame.font.Font) -> None:
        for i, p in enumerate(self.popups[-3:]):
            p.draw(surf, font_title, font_desc, i * 90)

    def reset(self) -> None:
        # Don't reset unlocked; keep persistent across matches in this session.
        self.popups.clear()


# =============================================================================
# LEADERBOARD
# =============================================================================
class Leaderboard:
    def __init__(self) -> None:
        self.entries: List[dict] = []
        self.load()

    def load(self) -> None:
        try:
            with open(LEADERBOARD_PATH, 'r', encoding='utf-8') as f:
                data = json.load(f)
                if isinstance(data, list):
                    self.entries = data
        except FileNotFoundError:
            self.entries = []
        except Exception as e:
            print(f"[Leaderboard] load error: {e}")
            self.entries = []

    def save(self) -> None:
        try:
            with open(LEADERBOARD_PATH, 'w', encoding='utf-8') as f:
                json.dump(self.entries, f, indent=2)
        except Exception as e:
            print(f"[Leaderboard] save error: {e}")

    def add(self, name: str, score: str, opponent: str,
            opponent_score: str) -> None:
        entry = {
            "name": name[:14] or "ANON",
            "score": score,
            "opponent": opponent[:14] or "AI",
            "opponent_score": opponent_score,
            "date": datetime.datetime.now().strftime("%Y-%m-%d %H:%M"),
        }
        self.entries.append(entry)
        # Keep top 25, sorted by winner score desc
        try:
            self.entries.sort(key=lambda e: -int(e["score"]))
        except Exception:
            pass
        self.entries = self.entries[:25]
        self.save()


# =============================================================================
# AI CONTROLLER
# =============================================================================
class CatAI:
    """A simple but fun reactive AI for the right-side cat blob."""

    def __init__(self, blob: CatBlob) -> None:
        self.blob = blob
        self.reaction_delay = 0.12  # seconds
        self.timer = 0.0
        self.target_x: float = blob.x
        self.want_jump = False
        self.error_px = 0.0

    def update(self, dt: float, ball: Ball, opponent: CatBlob) -> Tuple[int, bool]:
        self.timer += dt
        # Decide where to be
        # Predict where ball will be when it crosses blob's reach height
        reach_y = GROUND_Y - 80
        if ball.vy >= 0 and ball.y < reach_y and ball.x > NET_X - 80:
            # Simulate forward
            bx, by, bvx, bvy = ball.x, ball.y, ball.vx, ball.vy
            steps = 0
            while by < reach_y and steps < 200:
                bvy += GRAVITY * 0.9
                bx += bvx
                by += bvy
                bvx *= 0.998
                steps += 1
            predicted_x = bx
        else:
            predicted_x = ball.x

        # Aim slightly inside own court
        # Aim slightly inside own court (use the body's half-width so the
        # wider longitudinal shape stays fully inside the right half).
        half_w = self.blob.radius * BLOB_W_RATIO
        aim_x = clamp(predicted_x + self.error_px,
                      NET_X + half_w + 10,
                      WIDTH - half_w - 10)
        # Refresh error occasionally (so the AI isn't perfect)
        if self.timer > 1.5:
            self.error_px = random.uniform(-30, 30)
            self.timer = 0.0

        self.target_x = aim_x

        # Move toward target
        diff = self.target_x - self.blob.x
        if abs(diff) > 8:
            move = 1 if diff > 0 else -1
        else:
            move = 0

        # Decide to jump (spike attempt)
        want_jump = False
        if (NET_X < ball.x < WIDTH - 40
                and abs(ball.x - self.blob.x) < 70
                and ball.y > self.blob.y - 220
                and ball.y < self.blob.y - 80
                and self.blob.on_ground
                and ball.vy > -2):
            want_jump = True

        # Defensive jump: ball coming down right above us, near ground
        if (self.blob.on_ground
                and abs(ball.x - self.blob.x) < 50
                and ball.y > GROUND_Y - 120
                and ball.vy > 0):
            want_jump = True

        return move, want_jump


# =============================================================================
# GAME
# =============================================================================
class Game:
    STATE_MENU = 'menu'
    STATE_PLAYING = 'playing'
    STATE_PAUSED = 'paused'
    STATE_POINT = 'point'         # brief pause after a point
    STATE_GAME_OVER = 'gameover'
    STATE_NAME_ENTRY = 'name'
    STATE_LEADERBOARD = 'leaderboard'

    def __init__(self) -> None:
        pygame.init()
        # Display
        self.screen = pygame.display.set_mode((WIDTH, HEIGHT),
                                              pygame.SCALED, vsync=1)
        pygame.display.set_caption("Purr Volleyball")
        self.clock = pygame.time.Clock()

        # Audio
        self.audio = AudioEngine()
        # Start the synthwave bassline as soon as the game boots so the
        # main menu has audio (music continues across all screens except
        # when the user pauses or mutes).
        self.audio.start_music()

        # Fonts
        self.font_title    = pygame.font.SysFont("dejavuserif,liberationserif,notoserifsc", 72, bold=True)
        self.font_h1       = pygame.font.SysFont("dejavuserif,liberationserif,notoserifsc", 48, bold=True)
        self.font_h2       = pygame.font.SysFont("dejavusans,arial", 28, bold=True)
        self.font_body     = pygame.font.SysFont("dejavusans,arial", 20)
        self.font_small    = pygame.font.SysFont("dejavusans,arial", 16)
        self.font_mono     = pygame.font.SysFont("dejavusansmono,couriernew,monospace", 18, bold=True)
        self.font_popup_t  = pygame.font.SysFont("dejavusans,arial", 22, bold=True)
        self.font_popup_d  = pygame.font.SysFont("dejavusans,arial", 14)

        # Pre-rendered background
        self.bg = make_background(WIDTH, HEIGHT)

        # Game systems
        self.particles = ParticleSystem()
        self.achievements = AchievementManager(self.audio)
        self.leaderboard = Leaderboard()

        # State
        self.state = self.STATE_MENU
        self.menu_index = 0
        self.menu_items = ["1 Player (vs AI)", "2 Players", "Leaderboard", "Exit"]
        self.game_mode = "1p"  # "1p" or "2p"
        self.reduced_motion = False
        self.show_debug = False

        # Match state
        self.player1: Optional[CatBlob] = None
        self.player2: Optional[CatBlob] = None
        self.ai: Optional[CatAI] = None
        self.ball: Optional[Ball] = None
        self.net = Net()
        self.score_p1 = 0
        self.score_p2 = 0
        self.serving_side = -1   # who serves next
        self.rally_count = 0
        self.match_rallies = 0
        self.max_score_in_rally = 0
        self.max_deficit_p1 = 0  # how far p1 was behind
        self.point_timer = 0.0
        self.serve_timer = 0.0
        self.point_msg = ""
        self.point_msg_color = COL_TEXT
        self.winner: Optional[int] = None  # 1 or 2
        self.name_input = ""
        self.name_input_cursor = 0

        # Visual FX
        self.flash_t = 0.0
        self.flash_color = (255, 255, 255)
        self.shake_t = 0.0
        self.shake_amp = 0.0
        self.time_scale = 1.0  # for brief slow-mo on big hits

    # ==================================================================
    # MATCH FLOW
    # ==================================================================
    def start_match(self, mode: str) -> None:
        self.game_mode = mode
        self.player1 = CatBlob(220, COL_P1, facing=-1, is_ai=False)
        self.player2 = CatBlob(WIDTH - 220, COL_P2, facing=+1,
                               is_ai=(mode == "1p"))
        if mode == "1p":
            self.ai = CatAI(self.player2)
        else:
            self.ai = None
        self.ball = Ball()
        self.score_p1 = 0
        self.score_p2 = 0
        self.serving_side = -1  # P1 serves first
        self.rally_count = 0
        self.match_rallies = 0
        self.max_deficit_p1 = 0
        self.ball.reset(self.serving_side)
        self.particles.clear()
        self.achievements.reset()
        self.state = self.STATE_PLAYING
        self.serve_timer = 1.2
        self.audio.start_music()

    def end_match(self, winner: int) -> None:
        self.winner = winner
        if winner == 1 and self.score_p2 - self.score_p1 >= 5:
            # P1 came back from a big deficit
            self.achievements.unlock("comeback")
        margin = abs(self.score_p1 - self.score_p2)
        if margin >= 5:
            self.achievements.unlock("claw")
        if self.match_rallies >= 20:
            self.achievements.unlock("wallcat")
        self.state = self.STATE_GAME_OVER
        # Music keeps playing on the game-over screen (and back into the menu)
        self.audio.start_music()
        self.audio.play('score', 0.6)

    # ==================================================================
    # EVENT HANDLING
    # ==================================================================
    def handle_events(self) -> bool:
        """Returns False to quit."""
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_m:
                    self.audio.set_muted(not self.audio.muted)
                    continue
                if event.key == pygame.K_r:
                    self.reduced_motion = not self.reduced_motion
                    continue
                if event.key == pygame.K_F1:
                    self.show_debug = not self.show_debug
                    continue

                if self.state == self.STATE_MENU:
                    if event.key == pygame.K_UP:
                        self.menu_index = (self.menu_index - 1) % len(self.menu_items)
                    elif event.key == pygame.K_DOWN:
                        self.menu_index = (self.menu_index + 1) % len(self.menu_items)
                    elif event.key in (pygame.K_RETURN, pygame.K_SPACE):
                        self._activate_menu(self.menu_index)
                    elif event.key == pygame.K_ESCAPE:
                        return False
                elif self.state == self.STATE_PLAYING:
                    if event.key == pygame.K_ESCAPE:
                        self.state = self.STATE_PAUSED
                        self.audio.stop_music()
                    elif event.key == pygame.K_p:
                        self.state = self.STATE_PAUSED
                        self.audio.stop_music()
                elif self.state == self.STATE_PAUSED:
                    if event.key in (pygame.K_ESCAPE, pygame.K_p):
                        self.state = self.STATE_PLAYING
                        self.audio.start_music()
                    elif event.key == pygame.K_q:
                        self.state = self.STATE_MENU
                        # Music keeps playing across menu / leaderboard screens
                        self.audio.start_music()
                elif self.state == self.STATE_POINT:
                    pass  # auto-advances
                elif self.state == self.STATE_GAME_OVER:
                    if event.key == pygame.K_RETURN:
                        if self.winner == 1 or self.game_mode == "2p":
                            self.name_input = ""
                            self.state = self.STATE_NAME_ENTRY
                        else:
                            # AI won — no name needed
                            self.state = self.STATE_MENU
                            self.audio.start_music()
                    elif event.key == pygame.K_ESCAPE:
                        self.state = self.STATE_MENU
                        self.audio.start_music()
                elif self.state == self.STATE_NAME_ENTRY:
                    if event.key == pygame.K_RETURN:
                        winner_name = self.name_input.strip() or "ANON"
                        if self.winner == 1:
                            self.leaderboard.add(winner_name,
                                                 str(self.score_p1),
                                                 "P2 / AI",
                                                 str(self.score_p2))
                        else:
                            self.leaderboard.add(winner_name,
                                                 str(self.score_p2),
                                                 "P1",
                                                 str(self.score_p1))
                        self.state = self.STATE_LEADERBOARD
                    elif event.key == pygame.K_BACKSPACE:
                        self.name_input = self.name_input[:-1]
                    elif event.key == pygame.K_ESCAPE:
                        self.state = self.STATE_MENU
                        self.audio.start_music()
                    else:
                        # Accept printable chars
                        if len(self.name_input) < 14 and event.unicode and event.unicode.isprintable():
                            self.name_input += event.unicode
                elif self.state == self.STATE_LEADERBOARD:
                    if event.key in (pygame.K_ESCAPE, pygame.K_RETURN, pygame.K_SPACE):
                        self.state = self.STATE_MENU
                        self.audio.start_music()
        return True

    def _activate_menu(self, index: int) -> None:
        if index == 0:
            self.start_match("1p")
        elif index == 1:
            self.start_match("2p")
        elif index == 2:
            self.state = self.STATE_LEADERBOARD
        elif index == 3:
            pygame.event.post(pygame.event.Event(pygame.QUIT))

    # ==================================================================
    # UPDATE
    # ==================================================================
    def update(self, dt_real: float) -> None:
        dt = dt_real * self.time_scale
        # Decay FX
        if self.flash_t > 0:
            self.flash_t = max(0.0, self.flash_t - dt_real)
        if self.shake_t > 0:
            self.shake_t = max(0.0, self.shake_t - dt_real)
        # Time scale relax
        if self.time_scale < 1.0:
            self.time_scale = min(1.0, self.time_scale + dt_real * 2.0)

        self.particles.update(dt_real)
        self.achievements.update(dt_real)

        if self.state == self.STATE_PLAYING:
            self._update_playing(dt)
        elif self.state == self.STATE_POINT:
            self._update_point(dt_real)
        elif self.state == self.STATE_NAME_ENTRY:
            # Cursor blink handled in draw
            pass

    def _update_playing(self, dt: float) -> None:
        assert self.player1 and self.player2 and self.ball

        # --- Input gathering ---
        # Spacebar acts as a universal jump key for both players.
        keys = pygame.key.get_pressed()
        p1_move = (keys[pygame.K_d] or 0) - (keys[pygame.K_a] or 0)
        p1_jump = keys[pygame.K_w] or keys[pygame.K_SPACE]

        if self.game_mode == "2p":
            p2_move = (keys[pygame.K_RIGHT] or 0) - (keys[pygame.K_LEFT] or 0)
            # P2 jumps on Up arrow OR Space (Space is shared, both can use it).
            p2_jump = keys[pygame.K_UP] or keys[pygame.K_SPACE]
        else:
            assert self.ai is not None
            p2_move, p2_jump = self.ai.update(dt, self.ball, self.player1)

        # --- Update blobs ---
        ev1 = self.player1.update(dt, p1_move, p1_jump)
        ev2 = self.player2.update(dt, p2_move, p2_jump)
        if ev1 == 'jump':
            self.audio.play('jump', 0.45)
            self.particles.emit_burst(self.player1.x, self.player1.y,
                                      COL_P1, count=8, speed=2.5)
        if ev2 == 'jump':
            self.audio.play('jump', 0.45)
            self.particles.emit_burst(self.player2.x, self.player2.y,
                                      COL_P2, count=8, speed=2.5)

        # --- Serve handling ---
        # The ball stays frozen above the serving player until that player
        # presses their jump key (Space for either player, W for P1, Up for
        # P2). In 1P mode, if the AI is serving, the AI auto-serves after a
        # short delay so the human isn't waiting forever.
        if self.ball.frozen:
            # Keep the ball hovering above the server's head
            server = self.player1 if self.serving_side == -1 else self.player2
            self.ball.x = server.x
            self.ball.y = server.y - 110

            # Decide whether to launch the serve
            should_serve = False
            if self.serving_side == -1:
                # Player 1 serves when they press jump
                if p1_jump:
                    should_serve = True
            else:
                # Player 2's side serves
                if self.game_mode == "1p":
                    # AI auto-serves after a brief delay
                    self.serve_timer -= dt
                    if self.serve_timer <= 0:
                        should_serve = True
                else:
                    # 2P: human P2 must press jump
                    if p2_jump:
                        should_serve = True

            if should_serve:
                self.ball.frozen = False
                # Give ball a gentle initial nudge toward opponent
                self.ball.vx = -self.serving_side * 2.5
                self.ball.vy = 0.0

        # --- Update ball ---
        self.ball.update(dt)

        # --- Collisions ---
        if not self.ball.frozen:
            self._collide_ball_blob(self.player1, 1)
            self._collide_ball_blob(self.player2, 2)
            self._collide_ball_net()
            self._collide_ball_ground()

        # --- Hard-hit trail particles ---
        if not self.ball.frozen:
            speed = math.hypot(self.ball.vx, self.ball.vy)
            if speed > 7:
                col = COL_BALL_GLOW if self.ball.last_hit_by else COL_BALL
                self.particles.emit_trail(self.ball.x, self.ball.y, col,
                                          vx=-self.ball.vx * 0.15,
                                          vy=-self.ball.vy * 0.15,
                                          count=1 if speed < 11 else 2)

        # --- Achievement checks during rally ---
        if self.rally_count >= 3 and self.rally_count == 3:
            # combo: 3 successful touches in one rally
            # (we count touches on the same side as rally extension)
            pass  # handled at touch time

        # --- Track deficit for comeback achievement ---
        deficit = self.score_p2 - self.score_p1
        if deficit > self.max_deficit_p1:
            self.max_deficit_p1 = deficit

    def _collide_ball_blob(self, blob: CatBlob, player_num: int) -> None:
        assert self.ball is not None
        # Treat blob as a circle whose radius matches the longitudinal body's
        # mean radius (average of half-width and half-height). The collision
        # circle is centred on the body's geometric middle (see CatBlob.center).
        bcx, bcy = blob.center
        dx = self.ball.x - bcx
        dy = self.ball.y - bcy
        dist = math.hypot(dx, dy)
        # Mean of the body's half-width and half-height
        body_half_w = blob.radius * BLOB_W_RATIO
        body_half_h = blob.radius * BLOB_H_RATIO
        blob_coll_r = (body_half_w + body_half_h) * 0.5
        min_dist = self.ball.radius + blob_coll_r
        if dist < min_dist and dist > 0.01:
            # Normal vector
            nx = dx / dist
            ny = dy / dist
            # Push ball out of blob
            overlap = min_dist - dist
            self.ball.x += nx * overlap
            self.ball.y += ny * overlap
            # Reflect velocity along normal, with restitution
            v_dot_n = self.ball.vx * nx + self.ball.vy * ny
            if v_dot_n < 0:
                self.ball.vx -= (1 + BALL_RESTITUTION) * v_dot_n * nx
                self.ball.vy -= (1 + BALL_RESTITUTION) * v_dot_n * ny
            # Add blob's velocity influence (so jumping into the ball smashes it)
            self.ball.vx += blob.vx * 0.6
            self.ball.vy += blob.vy * 0.45
            # Bonus upward kick when ball is roughly on top of blob
            if ny < -0.4:
                self.ball.vy -= 2.5
            # Cap speeds
            speed = math.hypot(self.ball.vx, self.ball.vy)
            max_speed = 22.0
            if speed > max_speed:
                self.ball.vx *= max_speed / speed
                self.ball.vy *= max_speed / speed

            # Squish blob
            blob.squish_vy = -0.25
            blob.squish_vx = 0.18

            # Determine side and update touches
            side = -1 if player_num == 1 else +1
            if self.ball.last_side != side:
                # Side changed — reset that side's touches
                self.ball.touched_by_p1 = 0
                self.ball.touched_by_p2 = 0
                self.ball.last_side = side
                self.rally_count = 0
            if player_num == 1:
                self.ball.touched_by_p1 += 1
                self.ball.last_hit_by = 1
            else:
                self.ball.touched_by_p2 += 1
                self.ball.last_hit_by = 2
            self.rally_count += 1
            self.match_rallies += 1

            # --- Touch-limit foul ---
            touches = (self.ball.touched_by_p1 if player_num == 1
                       else self.ball.touched_by_p2)
            if touches > MAX_TOUCHES:
                # Other side scores
                winner = 2 if player_num == 1 else 1
                self._award_point(winner, reason="Too many touches!")
                return

            # --- Achievement: combo cat (3 clean touches in one rally) ---
            if self.rally_count == 3:
                # 3 successful touches means the rally has lasted 3 contacts
                self.achievements.unlock("combo")

            # --- Achievement: mega smash ---
            speed_after = math.hypot(self.ball.vx, self.ball.vy)
            if speed_after > 16:
                self.achievements.unlock("megasmash")
                self.particles.emit_burst(self.ball.x, self.ball.y,
                                          COL_ACCENT, count=24, speed=5)
                self.time_scale = 0.5
                self.shake_t = 0.25
                self.shake_amp = 6

            # --- Achievement: nine lives ---
            if self.ball.y > GROUND_Y - 30 and self.ball.vy < 0:
                self.achievements.unlock("ninelives")

            # Audio
            self.audio.play('hit', 0.55)
            # Particle splash
            col = COL_P1 if player_num == 1 else COL_P2
            self.particles.emit_burst(self.ball.x, self.ball.y,
                                      col, count=6, speed=2.5)
            if speed_after > 10:
                self.particles.emit_burst(self.ball.x, self.ball.y,
                                          COL_BALL, count=10, speed=4)

    def _collide_ball_net(self) -> None:
        assert self.ball is not None
        # Net is a thin vertical rect from (NET_X - t/2, NET_TOP_Y) to (NET_X + t/2, GROUND_Y)
        # Treat as box: if ball circle intersects rect, push out horizontally
        b = self.ball
        if (b.x + b.radius > self.net.rect.left and
                b.x - b.radius < self.net.rect.right and
                b.y + b.radius > self.net.rect.top and
                b.y - b.radius < self.net.rect.bottom):
            # Determine which side ball came from
            if b.x < self.net.rect.centerx:
                # Coming from left
                b.x = self.net.rect.left - b.radius
                b.vx = -abs(b.vx) * NET_RESTITUTION
            else:
                b.x = self.net.rect.right + b.radius
                b.vx = abs(b.vx) * NET_RESTITUTION
            # Damp vertical a bit
            b.vy *= 0.92
            self.audio.play('net', 0.5)
            self.particles.emit_burst(b.x, b.y, COL_NET, count=10, speed=3)
            # Slight upward kick so it doesn't get stuck
            if abs(b.vy) < 2:
                b.vy -= 1.5

    def _collide_ball_ground(self) -> None:
        assert self.ball is not None
        if self.ball.y + self.ball.radius >= GROUND_Y:
            self.ball.y = GROUND_Y - self.ball.radius
            # Determine side
            side = -1 if self.ball.x < NET_X else +1
            winner = 2 if side == -1 else 1
            # Check if it was an ace (opponent never touched)
            loser = 1 if winner == 2 else 2
            if self.ball.last_hit_by == winner and self.ball.last_side == side:
                # The ball landed on side, last touched by the winner → check ace
                touches_loser = (self.ball.touched_by_p1 if loser == 1
                                 else self.ball.touched_by_p2)
                if touches_loser == 0 and self.match_rallies <= 1:
                    self.achievements.unlock("ace")
            # First blood
            if self.score_p1 == 0 and self.score_p2 == 0:
                self.achievements.unlock("firstblood")
            self._award_point(winner, reason="Point!")

    def _award_point(self, winner: int, reason: str = "") -> None:
        if winner == 1:
            self.score_p1 += 1
            self.point_msg_color = COL_P1
            self.serving_side = -1
        else:
            self.score_p2 += 1
            self.point_msg_color = COL_P2
            self.serving_side = +1
        self.point_msg = reason or ("Point — Player %d" % winner)
        # Big flash + shake
        self.flash_t = 0.25
        self.flash_color = self.point_msg_color
        self.shake_t = 0.35
        self.shake_amp = 8
        self.particles.emit_burst(self.ball.x, GROUND_Y - 4,
                                  self.point_msg_color, count=30, speed=5)
        self.audio.play('score' if winner == 1 else 'score', 0.6)
        # Loser sound
        self.audio.play('lose', 0.35)
        # Check win
        if self.score_p1 >= WINNING_SCORE and self.score_p1 - self.score_p2 >= 2:
            self.end_match(1)
            return
        if self.score_p2 >= WINNING_SCORE and self.score_p2 - self.score_p1 >= 2:
            self.end_match(2)
            return
        # Otherwise go to brief point-pause
        self.state = self.STATE_POINT
        self.point_timer = 1.4
        # Freeze ball where it landed
        self.ball.frozen = True

    def _update_point(self, dt: float) -> None:
        self.point_timer -= dt
        if self.point_timer <= 0:
            # Reset for next rally
            assert self.ball is not None
            self.ball.reset(self.serving_side)
            self.serve_timer = 1.2
            self.rally_count = 0
            self.state = self.STATE_PLAYING

    # ==================================================================
    # DRAW
    # ==================================================================
    def draw(self) -> None:
        # Screen shake offset
        sx, sy = 0, 0
        if self.shake_t > 0 and not self.reduced_motion:
            amp = self.shake_amp * (self.shake_t / 0.35)
            sx = random.uniform(-amp, amp)
            sy = random.uniform(-amp, amp)

        # Draw onto an internal surface so shake offset works cleanly
        target = self.screen
        target.blit(self.bg, (int(sx), int(sy)))

        if self.state == self.STATE_MENU:
            self._draw_menu(target)
        elif self.state in (self.STATE_PLAYING, self.STATE_PAUSED, self.STATE_POINT):
            self._draw_court(target, sx, sy)
            if self.state == self.STATE_PAUSED:
                self._draw_pause(target)
            elif self.state == self.STATE_POINT:
                self._draw_point_msg(target)
        elif self.state == self.STATE_GAME_OVER:
            self._draw_court(target, sx, sy)
            self._draw_game_over(target)
        elif self.state == self.STATE_NAME_ENTRY:
            self._draw_name_entry(target)
        elif self.state == self.STATE_LEADERBOARD:
            self._draw_leaderboard(target)

        # Particles always drawn on top
        self.particles.draw(target)

        # Achievement popups
        self.achievements.draw(target, self.font_popup_t, self.font_popup_d)

        # Flash overlay
        if self.flash_t > 0 and not self.reduced_motion:
            alpha = int(120 * (self.flash_t / 0.25))
            flash = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            flash.fill((*self.flash_color, alpha))
            target.blit(flash, (0, 0))

        # Debug
        if self.show_debug:
            self._draw_debug(target)

        # Mute indicator
        if self.audio.muted:
            txt = self.font_small.render("[MUTED — press M]", True, COL_DANGER)
            target.blit(txt, (8, HEIGHT - 22))
        if self.reduced_motion:
            txt = self.font_small.render("[Reduced motion — press R]", True, COL_ACCENT)
            target.blit(txt, (8, HEIGHT - 42))

        pygame.display.flip()

    # ------------------------------------------------------------------
    def _draw_menu(self, surf: pygame.Surface) -> None:
        # Title with glow
        title = "PURR VOLLEYBALL"
        # Render glow layers
        for off in range(6, 0, -1):
            t = self.font_title.render(title, True, COL_TEXT_GLOW)
            t.set_alpha(60 // off)
            surf.blit(t, (WIDTH // 2 - t.get_width() // 2 + off,
                          110 + off))
        title_s = self.font_title.render(title, True, COL_TEXT)
        surf.blit(title_s, (WIDTH // 2 - title_s.get_width() // 2, 110))
        # Subtitle
        sub = self.font_h2.render("a neon synthwave blobby rally", True, COL_ACCENT)
        surf.blit(sub, (WIDTH // 2 - sub.get_width() // 2, 195))

        # Decorative cats preview
        # (small bouncing blobs in the background of the menu)
        t = pygame.time.get_ticks() / 1000.0
        # Left cat
        left = CatBlob(180, COL_P1, facing=-1)
        left.y = GROUND_Y + math.sin(t * 2) * -8
        left.draw(surf)
        # Right cat
        right = CatBlob(WIDTH - 180, COL_P2, facing=+1)
        right.y = GROUND_Y + math.sin(t * 2 + math.pi) * -8
        right.draw(surf)
        # Ball floating (snug glow, not a huge halo)
        bx = WIDTH // 2 + math.sin(t * 1.2) * 200
        by = 320 + math.cos(t * 1.6) * 30
        blit_glow(surf, COL_BALL_GLOW, (int(bx), int(by)), 22, 0.45)
        pygame.draw.circle(surf, COL_BALL, (int(bx), int(by)), 16)
        pygame.draw.circle(surf, (255, 255, 220),
                           (int(bx - 5), int(by - 5)), 5)

        # Menu items
        for i, item in enumerate(self.menu_items):
            y = 360 + i * 56
            selected = (i == self.menu_index)
            color = COL_ACCENT if selected else COL_TEXT
            label = self.font_h2.render(item, True, color)
            x = WIDTH // 2 - label.get_width() // 2
            if selected:
                # Glow + arrow
                blit_glow(surf, COL_ACCENT, (x - 30, y + 18), 20, 0.6)
                arrow = self.font_h2.render(">", True, COL_ACCENT)
                surf.blit(arrow, (x - 40, y))
            surf.blit(label, (x, y))

        # Footer hints
        hints = [
            "Controls — P1: A/D + W (or SPACE)    P2: Arrows (or SPACE)",
            "Press jump key to serve  •  M: mute  •  R: reduced motion  •  F1: debug",
        ]
        for i, h in enumerate(hints):
            s = self.font_small.render(h, True, COL_TEXT)
            surf.blit(s, (WIDTH // 2 - s.get_width() // 2,
                          HEIGHT - 60 + i * 20))

    def _draw_court(self, surf: pygame.Surface, sx: float, sy: float) -> None:
        assert self.player1 and self.player2 and self.ball
        # Net
        self.net.draw(surf)
        # Blobs
        self.player1.draw(surf)
        self.player2.draw(surf)
        # Ball
        self.ball.draw(surf)
        # HUD: scores
        self._draw_scores(surf)
        # Serve prompt: tell the serving player to press jump/Space.
        # Drawn on a solid dark panel so the text stays readable no matter
        # what's behind it (court, ball, blobs, etc.).
        if self.ball.frozen and self.state == self.STATE_PLAYING:
            if self.serving_side == -1:
                who = "PLAYER 1"
                key_hint = "press W or SPACE to serve"
                accent = COL_P1
            else:
                if self.game_mode == "1p":
                    who = "CPU"
                    key_hint = "serving..."
                else:
                    who = "PLAYER 2"
                    key_hint = "press UP or SPACE to serve"
                accent = COL_P2
            prompt = "%s — %s" % (who, key_hint)
            txt = self.font_h2.render(prompt, True, accent)
            # Dark rounded panel behind the text
            pad_x, pad_y = 20, 10
            panel_w = txt.get_width() + pad_x * 2
            panel_h = txt.get_height() + pad_y * 2
            panel = pygame.Surface((panel_w, panel_h), pygame.SRCALPHA)
            pygame.draw.rect(panel, (10, 5, 30, 220), panel.get_rect(),
                             border_radius=10)
            pygame.draw.rect(panel, accent, panel.get_rect(), 2,
                             border_radius=10)
            panel_x = WIDTH // 2 - panel_w // 2
            panel_y = 60
            surf.blit(panel, (panel_x, panel_y))
            surf.blit(txt, (panel_x + pad_x, panel_y + pad_y))
        # Touches indicator
        self._draw_touches(surf)
        # Onboarding hint
        if self.match_rallies < 2 and self.state == self.STATE_PLAYING:
            hint = "First to %d  •  Max 3 touches per side  •  SPACE = jump" % WINNING_SCORE
            s = self.font_small.render(hint, True, COL_TEXT)
            s.set_alpha(180)
            surf.blit(s, (WIDTH // 2 - s.get_width() // 2, HEIGHT - 30))

    def _draw_scores(self, surf: pygame.Surface) -> None:
        # Left score (no glow halo — was overlapping / obscuring the digits)
        s1 = self.font_h1.render(str(self.score_p1), True, COL_P1)
        surf.blit(s1, (60, 40))
        # Right score
        s2 = self.font_h1.render(str(self.score_p2), True, COL_P2)
        surf.blit(s2, (WIDTH - 60 - s2.get_width(), 40))
        # Labels
        l1 = self.font_small.render("PLAYER 1", True, COL_P1)
        surf.blit(l1, (60, 100))
        if self.game_mode == "1p":
            l2_txt = "CPU"
        else:
            l2_txt = "PLAYER 2"
        l2 = self.font_small.render(l2_txt, True, COL_P2)
        surf.blit(l2, (WIDTH - 60 - l2.get_width(), 100))
        # Center "to" label
        to = self.font_small.render("first to %d" % WINNING_SCORE,
                                    True, COL_TEXT)
        surf.blit(to, (WIDTH // 2 - to.get_width() // 2, 12))

    def _draw_touches(self, surf: pygame.Surface) -> None:
        assert self.ball is not None
        # Show dots under each player for touches used
        for player_num, blob, touches in [
            (1, self.player1, self.ball.touched_by_p1 if self.ball.last_side == -1 else 0),
            (2, self.player2, self.ball.touched_by_p2 if self.ball.last_side == +1 else 0),
        ]:
            for i in range(MAX_TOUCHES):
                cx = int(blob.x) + (i - 1) * 14
                cy = GROUND_Y + 20
                col = blob.color if i < touches else (60, 60, 80)
                pygame.draw.circle(surf, col, (cx, cy), 5)
                pygame.draw.circle(surf, (255, 255, 255), (cx, cy), 5, 1)

    def _draw_pause(self, surf: pygame.Surface) -> None:
        overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        overlay.fill((10, 5, 30, 180))
        surf.blit(overlay, (0, 0))
        t = self.font_title.render("PAUSED", True, COL_ACCENT)
        surf.blit(t, (WIDTH // 2 - t.get_width() // 2, 200))
        msg = self.font_h2.render("ESC / P to resume    Q to quit to menu",
                                  True, COL_TEXT)
        surf.blit(msg, (WIDTH // 2 - msg.get_width() // 2, 300))

    def _draw_point_msg(self, surf: pygame.Surface) -> None:
        # Big floating message on a dark panel so it's readable over any
        # background (court, blobs, ball, particles).
        s = self.font_h1.render(self.point_msg, True, self.point_msg_color)
        score_s = self.font_h2.render(
            "%d  —  %d" % (self.score_p1, self.score_p2),
            True, COL_TEXT)
        # Build a panel big enough for both lines
        pad_x, pad_y = 30, 16
        gap = 12
        panel_w = max(s.get_width(), score_s.get_width()) + pad_x * 2
        panel_h = s.get_height() + score_s.get_height() + pad_y * 2 + gap
        panel = pygame.Surface((panel_w, panel_h), pygame.SRCALPHA)
        pygame.draw.rect(panel, (10, 5, 30, 230), panel.get_rect(),
                         border_radius=14)
        pygame.draw.rect(panel, self.point_msg_color, panel.get_rect(), 3,
                         border_radius=14)
        panel_x = WIDTH // 2 - panel_w // 2
        panel_y = HEIGHT // 2 - panel_h // 2
        surf.blit(panel, (panel_x, panel_y))
        # Message line
        surf.blit(s, (panel_x + panel_w // 2 - s.get_width() // 2,
                      panel_y + pad_y))
        # Score line
        surf.blit(score_s,
                  (panel_x + panel_w // 2 - score_s.get_width() // 2,
                   panel_y + pad_y + s.get_height() + gap))

    def _draw_game_over(self, surf: pygame.Surface) -> None:
        overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        overlay.fill((10, 5, 30, 200))
        surf.blit(overlay, (0, 0))
        winner_col = COL_P1 if self.winner == 1 else COL_P2
        winner_name = "PLAYER 1" if self.winner == 1 else (
            "PLAYER 2" if self.game_mode == "2p" else "CPU")
        t = self.font_title.render("%s WINS!" % winner_name,
                                   True, winner_col)
        blit_glow(surf, winner_col,
                  (WIDTH // 2, 200), 120, 0.7)
        surf.blit(t, (WIDTH // 2 - t.get_width() // 2, 160))
        score = self.font_h1.render("%d  —  %d" % (self.score_p1, self.score_p2),
                                    True, COL_TEXT)
        surf.blit(score, (WIDTH // 2 - score.get_width() // 2, 260))
        # Achievements unlocked this match
        if self.achievements.unlocked:
            achv_title = self.font_h2.render("Achievements unlocked:",
                                             True, COL_ACCENT)
            surf.blit(achv_title, (WIDTH // 2 - achv_title.get_width() // 2, 340))
            for i, a in enumerate(ACHIEVEMENTS):
                if a.key in self.achievements.unlocked:
                    s = self.font_body.render("%s  %s" % (a.icon, a.title),
                                              True, COL_ACCENT)
                    surf.blit(s, (WIDTH // 2 - 150, 380 + i * 26))
        # Prompt
        if self.winner == 1 or self.game_mode == "2p":
            prompt = self.font_h2.render("ENTER to save your name    ESC to menu",
                                         True, COL_TEXT)
        else:
            prompt = self.font_h2.render("ENTER / ESC to return to menu",
                                         True, COL_TEXT)
        surf.blit(prompt, (WIDTH // 2 - prompt.get_width() // 2,
                           HEIGHT - 80))

    def _draw_name_entry(self, surf: pygame.Surface) -> None:
        overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        overlay.fill((10, 5, 30, 220))
        surf.blit(overlay, (0, 0))
        title = self.font_h1.render("ENTER YOUR NAME", True, COL_ACCENT)
        surf.blit(title, (WIDTH // 2 - title.get_width() // 2, 180))
        # Input box
        box_w, box_h = 400, 70
        box = pygame.Rect(WIDTH // 2 - box_w // 2, 280, box_w, box_h)
        blit_glow(surf, COL_ACCENT, box.center, 80, 0.5)
        pygame.draw.rect(surf, (20, 10, 50), box, border_radius=12)
        pygame.draw.rect(surf, COL_ACCENT, box, 2, border_radius=12)
        # Text + cursor
        cursor = "_" if int(pygame.time.get_ticks() / 500) % 2 == 0 else " "
        text = self.name_input + cursor
        s = self.font_h1.render(text, True, COL_TEXT)
        surf.blit(s, (box.x + 16, box.y + 12))
        # Hint
        hint = self.font_body.render(
            "Type your name, ENTER to confirm    ESC to skip",
            True, COL_TEXT)
        surf.blit(hint, (WIDTH // 2 - hint.get_width() // 2, 380))
        # Show score line
        if self.winner == 1:
            ln = "Final: %d — %d  (you won as Player 1)" % (self.score_p1, self.score_p2)
        else:
            ln = "Final: %d — %d  (you won as Player 2)" % (self.score_p1, self.score_p2)
        ls = self.font_body.render(ln, True, COL_ACCENT)
        surf.blit(ls, (WIDTH // 2 - ls.get_width() // 2, 430))

    def _draw_leaderboard(self, surf: pygame.Surface) -> None:
        # Title
        t = self.font_title.render("LEADERBOARD", True, COL_ACCENT)
        blit_glow(surf, COL_ACCENT, (WIDTH // 2, 100), 120, 0.5)
        surf.blit(t, (WIDTH // 2 - t.get_width() // 2, 60))

        # Column headers
        headers = ["#", "NAME", "SCORE", "OPPONENT", "DATE"]
        col_x = [80, 140, 360, 480, 700]
        for h, x in zip(headers, col_x):
            s = self.font_h2.render(h, True, COL_TEXT_GLOW)
            surf.blit(s, (x, 170))

        pygame.draw.line(surf, COL_TEXT_GLOW, (60, 210), (WIDTH - 60, 210), 2)

        if not self.leaderboard.entries:
            empty = self.font_h2.render("(no entries yet — go win a match!)",
                                        True, COL_TEXT)
            surf.blit(empty, (WIDTH // 2 - empty.get_width() // 2, 280))
        else:
            for i, e in enumerate(self.leaderboard.entries[:15]):
                y = 230 + i * 28
                # Highlight top 3
                if i == 0:
                    color = (255, 220, 100)
                elif i == 1:
                    color = (220, 220, 220)
                elif i == 2:
                    color = (205, 127, 50)
                else:
                    color = COL_TEXT
                row = [
                    "%d." % (i + 1),
                    e.get("name", "?"),
                    "%s — %s" % (e.get("score", "?"),
                                 e.get("opponent_score", "?")),
                    e.get("opponent", "?"),
                    e.get("date", "?"),
                ]
                for txt, x in zip(row, col_x):
                    s = self.font_mono.render(txt, True, color)
                    surf.blit(s, (x, y))

        # Hint
        hint = self.font_body.render("ESC / ENTER to return to menu",
                                     True, COL_TEXT)
        surf.blit(hint, (WIDTH // 2 - hint.get_width() // 2, HEIGHT - 50))

    def _draw_debug(self, surf: pygame.Surface) -> None:
        assert self.ball is not None
        lines = [
            "FPS: %.1f" % self.clock.get_fps(),
            "State: %s" % self.state,
            "Ball: (%.1f, %.1f)  v=(%.1f, %.1f)" % (
                self.ball.x, self.ball.y, self.ball.vx, self.ball.vy),
            "Rally: %d   Match rallies: %d" % (self.rally_count, self.match_rallies),
            "Touches P1/P2: %d / %d" % (self.ball.touched_by_p1,
                                         self.ball.touched_by_p2),
            "Particles: %d" % len(self.particles.particles),
            "Achievements: %d" % len(self.achievements.unlocked),
        ]
        for i, ln in enumerate(lines):
            s = self.font_mono.render(ln, True, COL_ACCENT)
            surf.blit(s, (10, 10 + i * 20))

    # ==================================================================
    # MAIN LOOP
    # ==================================================================
    def run(self) -> None:
        running = True
        try:
            while running:
                dt = min(self.clock.tick(FPS) / 1000.0, 1.0 / 30.0)
                running = self.handle_events()
                self.update(dt)
                self.draw()
        except KeyboardInterrupt:
            print("\n[Purr Volleyball] Interrupted by user.")
        finally:
            self.audio.stop_music()
            pygame.quit()


# =============================================================================
# ENTRY POINT
# =============================================================================
def main() -> None:
    Game().run()


if __name__ == "__main__":
    main()
