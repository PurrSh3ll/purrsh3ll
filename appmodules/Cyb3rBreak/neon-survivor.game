<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEON SURVIVOR</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    width: 100%; height: 100%; overflow: hidden;
    background: #05060f;
    font-family: 'Segoe UI', 'Trebuchet MS', system-ui, sans-serif;
    color: #cfe8ff;
    user-select: none;
  }
  #game { display: block; position: absolute; top: 0; left: 0; cursor: crosshair; }

  /* ---------- Overlay UI ---------- */
  .overlay {
    position: absolute; inset: 0; display: flex;
    align-items: center; justify-content: center;
    flex-direction: column; text-align: center;
    pointer-events: none; z-index: 10;
  }
  .overlay.active { pointer-events: auto; }
  .panel {
    background: rgba(8, 12, 28, 0.82);
    border: 1px solid rgba(0, 229, 255, 0.35);
    border-radius: 14px;
    padding: 36px 48px;
    box-shadow: 0 0 40px rgba(0, 229, 255, 0.25), inset 0 0 30px rgba(0,229,255,0.05);
    backdrop-filter: blur(6px);
    max-width: 560px;
  }
  h1.title {
    font-size: 64px; letter-spacing: 8px; font-weight: 800;
    color: #00e5ff;
    text-shadow: 0 0 18px #00e5ff, 0 0 40px #0088ff;
    margin-bottom: 6px;
  }
  .subtitle { color: #7fa8c8; letter-spacing: 4px; font-size: 13px; margin-bottom: 26px; }
  .btn {
    pointer-events: auto; cursor: pointer;
    background: linear-gradient(180deg, #00e5ff 0%, #0088ff 100%);
    color: #021018; font-weight: 800; letter-spacing: 2px;
    border: none; border-radius: 10px; padding: 14px 38px; font-size: 18px;
    box-shadow: 0 0 24px rgba(0,229,255,0.55);
    transition: transform .12s ease, box-shadow .12s ease;
    margin-top: 10px;
  }
  .btn:hover { transform: translateY(-2px) scale(1.03); box-shadow: 0 0 36px rgba(0,229,255,0.85); }
  .btn:active { transform: translateY(0) scale(0.99); }
  .controls {
    margin-top: 22px; font-size: 13px; color: #8fb3d0; line-height: 1.9;
  }
  .controls b { color: #00e5ff; }
  .stat-line { font-size: 15px; color: #bfe0ff; margin: 4px 0; }
  .stat-line .v { color: #00e5ff; font-weight: 800; }

  /* ---------- HUD ---------- */
  #hud {
    position: absolute; inset: 0; pointer-events: none; z-index: 5;
    font-size: 13px;
  }
  #topleft { position: absolute; top: 14px; left: 16px; }
  #topright { position: absolute; top: 14px; right: 16px; text-align: right; }
  #topcenter { position: absolute; top: 14px; left: 50%; transform: translateX(-50%); text-align: center; }
  .label { color: #6f93b3; letter-spacing: 2px; font-size: 11px; text-transform: uppercase; }
  .value { color: #00e5ff; font-size: 22px; font-weight: 800; text-shadow: 0 0 10px rgba(0,229,255,0.6); }
  .value.small { font-size: 16px; }
  .bar {
    width: 220px; height: 12px; border-radius: 6px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    overflow: hidden; margin-top: 4px;
  }
  #barWrap { width: 260px; }
  #hpFill {
    height: 100%; width: 100%;
    background: linear-gradient(90deg, #ff3b6b, #ff8a3b);
    box-shadow: 0 0 12px rgba(255,59,107,0.7);
    transition: width .15s ease;
  }
  #xpFill {
    height: 100%; width: 0%;
    background: linear-gradient(90deg, #00e5ff, #7dff8a);
    box-shadow: 0 0 12px rgba(0,229,255,0.6);
    transition: width .2s ease;
  }
  #barXp { width: 260px; height: 7px; margin-top: 6px; }
  #combo { color: #ffd23b; font-weight: 800; text-shadow: 0 0 10px rgba(255,210,59,0.7); }
  #waveBanner {
    position: absolute; top: 38%; left: 50%; transform: translate(-50%,-50%);
    font-size: 48px; font-weight: 800; letter-spacing: 6px;
    color: #00e5ff; text-shadow: 0 0 24px #00e5ff;
    opacity: 0; transition: opacity .4s ease; pointer-events: none; z-index: 6;
  }
  #bossBarWrap {
    position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
    width: 60%; max-width: 720px; display: none; z-index: 6;
  }
  #bossName { text-align:center; color:#ff3b6b; letter-spacing:4px; font-size:13px; font-weight:800; text-shadow:0 0 10px rgba(255,59,107,0.8); margin-bottom:4px;}
  #bossBar { height: 16px; border-radius: 8px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,59,107,0.5); overflow:hidden; box-shadow: 0 0 20px rgba(255,59,107,0.4);}
  #bossFill { height:100%; width:100%; background: linear-gradient(90deg,#ff3b6b,#ff8a3b); box-shadow:0 0 14px rgba(255,59,107,0.8); transition: width .2s ease;}

  #powerups { position: absolute; bottom: 14px; left: 16px; display: flex; gap: 8px; }
  .pchip {
    background: rgba(8,12,28,0.7); border: 1px solid rgba(0,229,255,0.4);
    border-radius: 8px; padding: 6px 10px; font-size: 12px; color: #bfe0ff;
    display: flex; align-items: center; gap: 6px;
  }
  .pchip .dot { width:8px; height:8px; border-radius:50%; box-shadow:0 0 8px currentColor; }
  #pauseHint { position:absolute; bottom:14px; right:16px; color:#5f7f9a; font-size:12px; letter-spacing:1px;}

  .hidden { display: none !important; }
</style>
</head>
<body>
<canvas id="game"></canvas>

<!-- HUD -->
<div id="hud" class="hidden">
  <div id="topleft">
    <div class="label">Hull Integrity</div>
    <div class="bar" id="barWrap"><div id="hpFill"></div></div>
    <div class="bar" id="barXp"><div id="xpFill"></div></div>
    <div class="label" style="margin-top:6px">Level <span id="lvlVal" class="value small">1</span></div>
  </div>
  <div id="topright">
    <div class="label">Score</div>
    <div class="value" id="scoreVal">0</div>
    <div class="label" style="margin-top:6px">High Score</div>
    <div class="value small" id="hiVal">0</div>
    <div id="combo" class="hidden" style="margin-top:8px; font-size:18px;">x1 COMBO</div>
  </div>
  <div id="topcenter">
    <div class="label">Wave</div>
    <div class="value" id="waveVal">1</div>
  </div>
  <div id="waveBanner"></div>
  <div id="bossBarWrap">
    <div id="bossName">GUARDIAN</div>
    <div id="bossBar"><div id="bossFill"></div></div>
  </div>
  <div id="powerups"></div>
  <div id="pauseHint">P to Pause</div>
</div>

<!-- Start menu -->
<div id="menu" class="overlay active">
  <div class="panel">
    <h1 class="title">NEON<br>SURVIVOR</h1>
    <div class="subtitle">SURVIVE · UPGRADE · DOMINATE</div>
    <button class="btn" id="startBtn">START GAME</button>
    <div class="controls">
      <b>WASD / Arrows</b> — Move &nbsp;·&nbsp; <b>Mouse</b> — Aim<br>
      <b>Left Click / Space</b> — Fire &nbsp;·&nbsp; <b>P</b> — Pause<br>
      <b>Shift</b> — Dash &nbsp;·&nbsp; Collect orbs to level up &amp; choose upgrades
    </div>
  </div>
</div>

<!-- Pause menu -->
<div id="pauseMenu" class="overlay hidden">
  <div class="panel">
    <h1 class="title" style="font-size:42px">PAUSED</h1>
    <button class="btn" id="resumeBtn">RESUME</button>
  </div>
</div>

<!-- Upgrade menu -->
<div id="upgradeMenu" class="overlay hidden">
  <div class="panel" style="max-width:720px">
    <h1 class="title" style="font-size:34px; letter-spacing:4px">LEVEL UP</h1>
    <div class="subtitle">CHOOSE AN UPGRADE</div>
    <div id="upgradeChoices" style="display:flex; gap:14px; flex-wrap:wrap; justify-content:center; margin-top:10px;"></div>
  </div>
</div>

<!-- Game over -->
<div id="gameover" class="overlay hidden">
  <div class="panel">
    <h1 class="title" style="font-size:48px; color:#ff3b6b; text-shadow:0 0 18px #ff3b6b, 0 0 40px #ff3b6b;">GAME OVER</h1>
    <div class="stat-line">Final Score: <span class="v" id="goScore">0</span></div>
    <div class="stat-line">Wave Reached: <span class="v" id="goWave">1</span></div>
    <div class="stat-line">Enemies Destroyed: <span class="v" id="goKills">0</span></div>
    <div class="stat-line">Time Survived: <span class="v" id="goTime">0s</span></div>
    <div class="stat-line" id="goRecord" style="color:#ffd23b;"></div>
    <button class="btn" id="retryBtn">PLAY AGAIN</button>
  </div>
</div>

<script>
"use strict";
/* ============================================================
   NEON SURVIVOR — single-file arena survival shooter
   ============================================================ */

const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
let W = 0, H = 0, DPR = Math.min(window.devicePixelRatio || 1, 2);

function resize() {
  W = window.innerWidth; H = window.innerHeight;
  canvas.width = W * DPR; canvas.height = H * DPR;
  canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
}
window.addEventListener('resize', resize); resize();

/* ---------- Utility ---------- */
const TAU = Math.PI * 2;
const rand = (a, b) => a + Math.random() * (b - a);
const randi = (a, b) => Math.floor(rand(a, b + 1));
const pick = arr => arr[Math.floor(Math.random() * arr.length)];
const clamp = (v, a, b) => v < a ? a : v > b ? b : v;
const dist2 = (ax, ay, bx, by) => { const dx=ax-bx, dy=ay-by; return dx*dx+dy*dy; };
const len = (x, y) => Math.hypot(x, y);
const norm = (x, y) => { const l = Math.hypot(x, y) || 1; return [x/l, y/l]; };
const lerp = (a, b, t) => a + (b - a) * t;

/* ---------- Audio (Web Audio API procedural) ---------- */
const Audio = (() => {
  let ctxA = null, master = null, enabled = true;
  function init() {
    if (ctxA) return;
    try {
      ctxA = new (window.AudioContext || window.webkitAudioContext)();
      master = ctxA.createGain();
      master.gain.value = 0.35;
      master.connect(ctxA.destination);
    } catch(e) { enabled = false; }
  }
  function tone(freq, dur, type='square', vol=0.3, slide=0) {
    if (!enabled || !ctxA) return;
    const t = ctxA.currentTime;
    const o = ctxA.createOscillator();
    const g = ctxA.createGain();
    o.type = type; o.frequency.setValueAtTime(freq, t);
    if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq + slide), t + dur);
    g.gain.setValueAtTime(vol, t);
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    o.connect(g); g.connect(master);
    o.start(t); o.stop(t + dur + 0.02);
  }
  function noise(dur, vol=0.3, filterFreq=800) {
    if (!enabled || !ctxA) return;
    const t = ctxA.currentTime;
    const buf = ctxA.createBuffer(1, ctxA.sampleRate * dur, ctxA.sampleRate);
    const d = buf.getChannelData(0);
    for (let i=0;i<d.length;i++) d[i] = (Math.random()*2-1) * (1 - i/d.length);
    const src = ctxA.createBufferSource(); src.buffer = buf;
    const filt = ctxA.createBiquadFilter(); filt.type='lowpass'; filt.frequency.value=filterFreq;
    const g = ctxA.createGain(); g.gain.value = vol;
    src.connect(filt); filt.connect(g); g.connect(master);
    src.start(t);
  }
  return {
    init,
    shoot: () => tone(880, 0.07, 'square', 0.12, -500),
    enemyShoot: () => tone(320, 0.1, 'sawtooth', 0.1, -100),
    hit: () => tone(180, 0.06, 'square', 0.12, -80),
    explode: () => { noise(0.35, 0.4, 1200); tone(120, 0.3, 'sawtooth', 0.2, -80); },
    bigExplode: () => { noise(0.6, 0.5, 900); tone(80, 0.6, 'sawtooth', 0.25, -50); },
    powerup: () => { tone(660,0.08,'sine',0.2); setTimeout(()=>tone(990,0.1,'sine',0.2),70); },
    levelup: () => { tone(523,0.1,'triangle',0.25); setTimeout(()=>tone(784,0.1,'triangle',0.25),90); setTimeout(()=>tone(1046,0.16,'triangle',0.25),190); },
    dash: () => tone(440, 0.15, 'sine', 0.18, 600),
    hurt: () => { tone(200,0.2,'sawtooth',0.25,-120); noise(0.2,0.2,500); },
    wave: () => { tone(330,0.15,'triangle',0.2); setTimeout(()=>tone(440,0.2,'triangle',0.2),140); },
    boss: () => { tone(110,0.5,'sawtooth',0.3,-30); noise(0.5,0.3,400); }
  };
})();

/* ---------- Input ---------- */
const Input = {
  keys: {}, mouse: {x: 0, y: 0}, down: false, spaceDown: false,
  dashPressed: false
};
window.addEventListener('keydown', e => {
  Input.keys[e.key.toLowerCase()] = true;
  if (e.key === ' ') { Input.spaceDown = true; e.preventDefault(); }
  if (e.key.toLowerCase() === 'p') Game.togglePause();
  if (e.key === 'Shift') Input.dashPressed = true;
});
window.addEventListener('keyup', e => {
  Input.keys[e.key.toLowerCase()] = false;
  if (e.key === ' ') Input.spaceDown = false;
});
canvas.addEventListener('mousemove', e => { Input.mouse.x = e.clientX; Input.mouse.y = e.clientY; });
canvas.addEventListener('mousedown', e => { Input.down = true; Audio.init(); });
canvas.addEventListener('mouseup', e => { Input.down = false; });
canvas.addEventListener('contextmenu', e => e.preventDefault());

/* ---------- Game State ---------- */
const Game = {
  state: 'menu', // menu, playing, paused, upgrade, gameover
  time: 0, startTime: 0,
  shake: 0, shakeT: 0,
  flash: 0, flashColor: '#ffffff',
  slowmo: 1,
  wave: 0, waveTimer: 0, waveActive: false, enemiesToSpawn: 0, spawnTimer: 0,
  kills: 0,
  highScore: parseInt(localStorage.getItem('neonSurvivorHi') || '0', 10),
  player: null,
  bullets: [], enemyBullets: [], enemies: [], particles: [], powerups: [], floaters: [], orbs: [],
  boss: null,
  pendingUpgrades: 0,
  init() {
    document.getElementById('hiVal').textContent = this.highScore;
  },
  start() {
    Audio.init();
    this.state = 'playing';
    this.time = 0; this.startTime = performance.now();
    this.wave = 0; this.kills = 0; this.waveTimer = 0; this.waveActive = false;
    this.bullets = []; this.enemyBullets = []; this.enemies = [];
    this.particles = []; this.powerups = []; this.floaters = []; this.orbs = [];
    this.boss = null; this.shake = 0; this.slowmo = 1; this.pendingUpgrades = 0;
    this.player = new Player(W/2, H/2);
    document.getElementById('menu').classList.remove('active');
    document.getElementById('menu').classList.add('hidden');
    document.getElementById('gameover').classList.add('hidden');
    document.getElementById('hud').classList.remove('hidden');
    this.nextWave();
  },
  togglePause() {
    if (this.state === 'playing') {
      this.state = 'paused';
      document.getElementById('pauseMenu').classList.remove('hidden');
      document.getElementById('pauseMenu').classList.add('active');
    } else if (this.state === 'paused') {
      this.state = 'playing';
      document.getElementById('pauseMenu').classList.add('hidden');
      document.getElementById('pauseMenu').classList.remove('active');
    }
  },
  nextWave() {
    this.wave++;
    this.waveActive = true;
    this.waveTimer = 0;
    document.getElementById('waveVal').textContent = this.wave;
    this.showBanner('WAVE ' + this.wave);
    Audio.wave();
    // Boss every 5 waves
    if (this.wave % 5 === 0) {
      this.spawnBoss();
      this.enemiesToSpawn = 0;
    } else {
      this.enemiesToSpawn = 6 + this.wave * 3;
      this.spawnTimer = 0;
    }
  },
  spawnBoss() {
    Audio.boss();
    this.showBanner('BOSS INCOMING', '#ff3b6b');
    setTimeout(() => {
      this.boss = new Boss(W/2, -80);
      document.getElementById('bossBarWrap').style.display = 'block';
    }, 800);
  },
  showBanner(text, color='#00e5ff') {
    const b = document.getElementById('waveBanner');
    b.textContent = text; b.style.color = color; b.style.textShadow = `0 0 24px ${color}`;
    b.style.opacity = '1';
    setTimeout(() => { b.style.opacity = '0'; }, 1400);
  },
  addShake(amount) { this.shake = Math.min(this.shake + amount, 24); },
  addFlash(color, amt=0.5) { this.flash = Math.min(this.flash + amt, 1); this.flashColor = color; },
  gameOver() {
    this.state = 'gameover';
    const score = Math.floor(this.player.score);
    const isRecord = score > this.highScore;
    if (isRecord) { this.highScore = score; localStorage.setItem('neonSurvivorHi', score); }
    document.getElementById('goScore').textContent = score;
    document.getElementById('goWave').textContent = this.wave;
    document.getElementById('goKills').textContent = this.kills;
    document.getElementById('goTime').textContent = Math.floor((performance.now()-this.startTime)/1000) + 's';
    document.getElementById('goRecord').textContent = isRecord ? '★ NEW HIGH SCORE ★' : '';
    document.getElementById('hiVal').textContent = this.highScore;
    document.getElementById('gameover').classList.remove('hidden');
    document.getElementById('gameover').classList.add('active');
    document.getElementById('bossBarWrap').style.display = 'none';
  },
  update(dt) {
    if (this.state !== 'playing') return;
    this.time += dt;
    // slowmo easing
    this.slowmo = lerp(this.slowmo, 1, dt * 3);
    const sdt = dt * this.slowmo;

    this.player.update(sdt);

    // wave logic
    if (this.waveActive) {
      if (this.enemiesToSpawn > 0) {
        this.spawnTimer -= sdt;
        if (this.spawnTimer <= 0) {
          this.spawnEnemy();
          this.enemiesToSpawn--;
          this.spawnTimer = Math.max(0.25, 1.1 - this.wave * 0.04);
        }
      } else if (this.enemies.length === 0 && !this.boss) {
        this.waveActive = false;
        this.waveTimer = 0;
      }
    } else {
      this.waveTimer += sdt;
      if (this.waveTimer > 2.2) this.nextWave();
    }

    if (this.boss) {
      this.boss.update(sdt);
      document.getElementById('bossFill').style.width = (this.boss.hp/this.boss.maxHp*100) + '%';
    }

    for (const b of this.bullets) b.update(sdt);
    for (const b of this.enemyBullets) b.update(sdt);
    for (const e of this.enemies) e.update(sdt);
    for (const p of this.particles) p.update(sdt);
    for (const p of this.powerups) p.update(sdt);
    for (const f of this.floaters) f.update(sdt);
    for (const o of this.orbs) o.update(sdt);

    // collisions
    this.collisions();

    // cleanup
    this.bullets = this.bullets.filter(b => b.alive);
    this.enemyBullets = this.enemyBullets.filter(b => b.alive);
    this.enemies = this.enemies.filter(e => e.alive);
    this.particles = this.particles.filter(p => p.alive);
    this.powerups = this.powerups.filter(p => p.alive);
    this.floaters = this.floaters.filter(f => f.alive);
    this.orbs = this.orbs.filter(o => o.alive);

    // shake decay
    this.shake *= Math.pow(0.001, dt);
    this.flash *= Math.pow(0.0001, dt);

    // HUD
    this.updateHUD();
  },
  spawnEnemy() {
    // spawn off-screen edge
    const edge = randi(0,3);
    let x, y; const m = 60;
    if (edge===0){x=rand(0,W);y=-m;} else if(edge===1){x=W+m;y=rand(0,H);}
    else if(edge===2){x=rand(0,W);y=H+m;} else {x=-m;y=rand(0,H);}
    // type based on wave
    const r = Math.random();
    let type = 'chaser';
    if (this.wave >= 3 && r < 0.28) type = 'shooter';
    else if (this.wave >= 5 && r < 0.42) type = 'shooter';
    if (this.wave >= 6 && r > 0.88) type = 'tank';
    this.enemies.push(new Enemy(x, y, type));
  },
  collisions() {
    const p = this.player;
    // bullets vs enemies
    for (const b of this.bullets) {
      if (!b.alive) continue;
      for (const e of this.enemies) {
        if (!e.alive) continue;
        if (dist2(b.x,b.y,e.x,e.y) < (e.r+b.r)*(e.r+b.r)) {
          e.damage(b.dmg, b.x, b.y);
          b.alive = false;
          if (b.pierce > 0) { b.pierce--; } else break;
        }
      }
      if (b.alive && this.boss && this.boss.alive) {
        if (dist2(b.x,b.y,this.boss.x,this.boss.y) < (this.boss.r+b.r)*(this.boss.r+b.r)) {
          this.boss.damage(b.dmg, b.x, b.y);
          b.alive = false;
        }
      }
    }
    // enemy bullets vs player
    if (!p.invuln) {
      for (const b of this.enemyBullets) {
        if (!b.alive) continue;
        if (dist2(b.x,b.y,p.x,p.y) < (p.r+b.r)*(p.r+b.r)) {
          p.hurt(b.dmg);
          b.alive = false;
        }
      }
    }
    // enemies vs player
    if (!p.invuln) {
      for (const e of this.enemies) {
        if (!e.alive) continue;
        if (dist2(e.x,e.y,p.x,p.y) < (e.r+p.r)*(e.r+p.r)) {
          p.hurt(e.contactDmg);
          // knockback
          const [nx,ny] = norm(p.x-e.x, p.y-e.y);
          p.vx += nx * 180; p.vy += ny * 180;
          e.vx -= nx * 120; e.vy -= ny * 120;
          if (e.type==='chaser') e.damage(40, e.x, e.y); // chasers take damage on contact
        }
      }
      if (this.boss && this.boss.alive && dist2(this.boss.x,this.boss.y,p.x,p.y) < (this.boss.r+p.r)*(this.boss.r+p.r)) {
        p.hurt(18);
        const [nx,ny] = norm(p.x-this.boss.x, p.y-this.boss.y);
        p.vx += nx*300; p.vy += ny*300;
      }
    }
    // orbs vs player
    for (const o of this.orbs) {
      if (!o.alive) continue;
      if (dist2(o.x,o.y,p.x,p.y) < (p.r+o.r+40)*(p.r+o.r+40)) {
        // magnet
        const [nx,ny] = norm(p.x-o.x, p.y-o.y);
        o.vx += nx * 1400 * 0.016; o.vy += ny * 1400 * 0.016;
      }
      if (dist2(o.x,o.y,p.x,p.y) < (p.r+o.r)*(p.r+o.r)) {
        o.alive = false;
        p.addXp(o.value);
        this.floaters.push(new Floater(o.x, o.y, '+'+o.value, '#7dff8a'));
      }
    }
    // powerups vs player
    for (const pu of this.powerups) {
      if (!pu.alive) continue;
      if (dist2(pu.x,pu.y,p.x,p.y) < (p.r+pu.r+10)*(p.r+pu.r+10)) {
        pu.alive = false;
        p.applyPowerup(pu.type);
        this.floaters.push(new Floater(pu.x, pu.y, pu.label, pu.color));
        Audio.powerup();
      }
    }
  },
  updateHUD() {
    const p = this.player;
    document.getElementById('hpFill').style.width = clamp(p.hp/p.maxHp*100,0,100) + '%';
    document.getElementById('xpFill').style.width = (p.xp/p.xpNeeded*100) + '%';
    document.getElementById('lvlVal').textContent = p.level;
    document.getElementById('scoreVal').textContent = Math.floor(p.score);
    // combo display
    const cd = document.getElementById('combo');
    if (p.combo > 1) { cd.classList.remove('hidden'); cd.textContent = 'x'+p.combo+' COMBO'; }
    else cd.classList.add('hidden');
    // powerup chips
    const wrap = document.getElementById('powerups');
    wrap.innerHTML = '';
    for (const key of Object.keys(p.activePowerups)) {
      const a = p.activePowerups[key];
      const chip = document.createElement('div');
      chip.className = 'pchip';
      chip.innerHTML = `<span class="dot" style="background:${a.color};color:${a.color}"></span>${a.label} ${a.t>0?a.t.toFixed(1)+'s':'∞'}`;
      wrap.appendChild(chip);
    }
  },
  render() {
    // shake offset
    let ox = 0, oy = 0;
    if (this.shake > 0.1) {
      ox = rand(-this.shake, this.shake);
      oy = rand(-this.shake, this.shake);
    }
    ctx.save();
    ctx.translate(ox, oy);

    // background
    ctx.fillStyle = '#05060f';
    ctx.fillRect(-ox, -oy, W, H);
    this.drawGrid(-ox, -oy);
    this.drawVignette();

    // world entities
    for (const o of this.orbs) o.draw();
    for (const p of this.powerups) p.draw();
    for (const b of this.enemyBullets) b.draw();
    for (const e of this.enemies) e.draw();
    if (this.boss) this.boss.draw();
    if (this.player) this.player.draw();
    for (const b of this.bullets) b.draw();
    for (const p of this.particles) p.draw();
    for (const f of this.floaters) f.draw();

    ctx.restore();

    // flash overlay
    if (this.flash > 0.01) {
      ctx.save();
      ctx.globalAlpha = this.flash * 0.5;
      ctx.fillStyle = this.flashColor;
      ctx.fillRect(0,0,W,H);
      ctx.restore();
    }
  },
  drawGrid(ox, oy) {
    const size = 50;
    ctx.strokeStyle = 'rgba(0, 120, 180, 0.10)';
    ctx.lineWidth = 1;
    const offX = ((-ox) % size + size) % size;
    const offY = ((-oy) % size + size) % size;
    ctx.beginPath();
    for (let x = offX; x < W; x += size) { ctx.moveTo(x, 0); ctx.lineTo(x, H); }
    for (let y = offY; y < H; y += size) { ctx.moveTo(0, y); ctx.lineTo(W, y); }
    ctx.stroke();
    // bright dots at intersections
    ctx.fillStyle = 'rgba(0, 229, 255, 0.18)';
    for (let x = offX; x < W; x += size) {
      for (let y = offY; y < H; y += size) {
        ctx.fillRect(x-1, y-1, 2, 2);
      }
    }
  },
  drawVignette() {
    const g = ctx.createRadialGradient(W/2,H/2,Math.min(W,H)*0.3, W/2,H/2,Math.max(W,H)*0.75);
    g.addColorStop(0, 'rgba(0,0,0,0)');
    g.addColorStop(1, 'rgba(0,0,0,0.55)');
    ctx.fillStyle = g;
    ctx.fillRect(0,0,W,H);
  }
};
Game.init();

/* ---------- Glow helper ---------- */
function glow(ctx, color, blur) {
  ctx.shadowColor = color; ctx.shadowBlur = blur;
}
function noGlow(ctx) { ctx.shadowBlur = 0; }

/* ---------- Player ---------- */
class Player {
  constructor(x, y) {
    this.x = x; this.y = y; this.r = 14;
    this.vx = 0; this.vy = 0;
    this.speed = 280;
    this.hp = 100; this.maxHp = 100;
    this.angle = 0;
    this.fireCooldown = 0; this.fireRate = 0.16; // seconds between shots
    this.bulletDmg = 18; this.bulletSpeed = 620; this.bulletR = 4;
    this.pierce = 0; this.multishot = 1; this.spread = 0;
    this.invuln = false; this.invulnT = 0;
    this.dashCooldown = 0; this.dashing = 0;
    this.thrustT = 0;
    this.score = 0; this.xp = 0; this.level = 1; this.xpNeeded = 8;
    this.combo = 1; this.comboTimer = 0;
    this.shieldHp = 0;
    this.activePowerups = {}; // key -> {label, color, t}
    this.regen = 0; // hp per second
    this.critChance = 0; this.critMult = 2;
    this.lifesteal = 0;
    this.magnet = 1;
    this.alive = true;
  }
  addXp(v) {
    this.xp += v * this.combo;
    this.score += v * 5 * this.combo;
    while (this.xp >= this.xpNeeded) {
      this.xp -= this.xpNeeded;
      this.level++;
      this.xpNeeded = Math.floor(this.xpNeeded * 1.35 + 4);
      Game.pendingUpgrades++;
      Audio.levelup();
    }
    if (Game.pendingUpgrades > 0 && Game.state === 'playing') {
      Game.state = 'upgrade';
      showUpgrades();
    }
  }
  addScore(v) {
    this.comboTimer = 3;
    this.score += v * this.combo;
  }
  applyPowerup(type) {
    const defs = {
      rapid:    { label:'RAPID FIRE', color:'#00e5ff', dur:8 },
      spread:   { label:'SPREAD SHOT', color:'#7dff8a', dur:8 },
      shield:   { label:'SHIELD', color:'#ffd23b', dur:0 },
      heal:     { label:'REPAIR', color:'#ff8a3b', dur:0 },
      slow:     { label:'SLOW TIME', color:'#b388ff', dur:5 },
      damage:   { label:'OVERCHARGE', color:'#ff3b6b', dur:8 },
    };
    const d = defs[type];
    if (type === 'shield') { this.shieldHp = 50; this.activePowerups.shield = {label:'SHIELD', color:'#ffd23b', t:0}; }
    else if (type === 'heal') { this.hp = Math.min(this.maxHp, this.hp + 40); }
    else if (type === 'slow') { Game.slowmo = 0.4; this.activePowerups.slow = {label:'SLOW TIME', color:'#b388ff', t:d.dur}; }
    else { this.activePowerups[type] = {label:d.label, color:d.color, t:d.dur}; }
  }
  hurt(dmg) {
    if (this.invuln || this.dashing > 0) return;
    if (this.shieldHp > 0) {
      this.shieldHp -= dmg;
      if (this.shieldHp <= 0) { delete this.activePowerups.shield; this.shieldHp = 0; }
      this.invuln = true; this.invulnT = 0.4;
      Audio.hit();
      return;
    }
    this.hp -= dmg;
    this.invuln = true; this.invulnT = 0.6;
    Game.addShake(10); Game.addFlash('#ff3b6b', 0.4);
    Audio.hurt();
    this.combo = 1; this.comboTimer = 0;
    if (this.hp <= 0) { this.hp = 0; this.die(); }
  }
  die() {
    this.alive = false;
    Audio.bigExplode();
    Game.addShake(30); Game.addFlash('#ff3b6b', 0.9);
    for (let i=0;i<60;i++) {
      Game.particles.push(new Particle(this.x, this.y, rand(0,TAU), rand(60,320), rand(0.6,1.4), pick(['#00e5ff','#ffffff','#ff3b6b','#ffd23b']), rand(2,5)));
    }
    Game.gameOver();
  }
  fire() {
    if (this.fireCooldown > 0) return;
    let rate = this.fireRate;
    if (this.activePowerups.rapid) rate *= 0.45;
    this.fireCooldown = rate;
    const shots = this.multishot + (this.activePowerups.spread ? 2 : 0);
    const spreadAngle = this.spread + (this.activePowerups.spread ? 0.32 : 0);
    for (let i=0;i<shots;i++) {
      const t = shots === 1 ? 0 : (i/(shots-1) - 0.5);
      const a = this.angle + t * spreadAngle;
      let dmg = this.bulletDmg;
      let crit = false;
      if (Math.random() < this.critChance) { dmg *= this.critMult; crit = true; }
      if (this.activePowerups.damage) dmg *= 1.8;
      Game.bullets.push(new Bullet(this.x + Math.cos(this.angle)*this.r, this.y + Math.sin(this.angle)*this.r, a, this.bulletSpeed, dmg, this.pierce, this.bulletR, crit));
    }
    Audio.shoot();
    // muzzle flash
    for (let i=0;i<3;i++) {
      Game.particles.push(new Particle(this.x+Math.cos(this.angle)*this.r, this.y+Math.sin(this.angle)*this.r, this.angle+rand(-0.4,0.4), rand(80,200), rand(0.1,0.25), '#00e5ff', rand(1.5,3)));
    }
  }
  update(dt) {
    // input movement
    let mx = 0, my = 0;
    if (Input.keys['w'] || Input.keys['arrowup']) my -= 1;
    if (Input.keys['s'] || Input.keys['arrowdown']) my += 1;
    if (Input.keys['a'] || Input.keys['arrowleft']) mx -= 1;
    if (Input.keys['d'] || Input.keys['arrowright']) mx += 1;
    if (mx || my) { const [nx,ny] = norm(mx,my); mx=nx; my=ny; this.thrustT += dt; }
    else this.thrustT = 0;

    // dash
    if (Input.dashPressed && this.dashCooldown <= 0 && (mx||my)) {
      this.dashing = 0.18; this.dashCooldown = 1.2;
      this.vx = mx * 900; this.vy = my * 900;
      Audio.dash();
      Game.addFlash('#00e5ff', 0.15);
      Input.dashPressed = false;
      // dash trail
      for (let i=0;i<12;i++) Game.particles.push(new Particle(this.x,this.y,rand(0,TAU),rand(20,120),rand(0.2,0.5),'#00e5ff',rand(2,4)));
    }
    Input.dashPressed = false;

    if (this.dashing > 0) {
      this.dashing -= dt;
    } else {
      const targetVx = mx * this.speed, targetVy = my * this.speed;
      this.vx = lerp(this.vx, targetVx, 1 - Math.pow(0.0001, dt));
      this.vy = lerp(this.vy, targetVy, 1 - Math.pow(0.0001, dt));
    }

    this.x += this.vx * dt;
    this.y += this.vy * dt;
    this.x = clamp(this.x, this.r, W - this.r);
    this.y = clamp(this.y, this.r, H - this.r);
    // bounce off walls slightly
    if (this.x <= this.r || this.x >= W-this.r) this.vx *= -0.4;
    if (this.y <= this.r || this.y >= H-this.r) this.vy *= -0.4;

    // aim
    this.angle = Math.atan2(Input.mouse.y - this.y, Input.mouse.x - this.x);

    // fire
    if (Input.down || Input.spaceDown) this.fire();
    this.fireCooldown -= dt;
    this.dashCooldown -= dt;
    if (this.invuln) { this.invulnT -= dt; if (this.invulnT <= 0) this.invuln = false; }

    // thrust particles
    if (this.thrustT > 0 && this.dashing <= 0) {
      const back = this.angle + Math.PI;
      Game.particles.push(new Particle(this.x+Math.cos(back)*this.r*0.6, this.y+Math.sin(back)*this.r*0.6, back+rand(-0.5,0.5), rand(40,120), rand(0.2,0.4), pick(['#00e5ff','#0088ff','#ffffff']), rand(1.5,3)));
    }

    // regen
    if (this.regen > 0 && this.hp < this.maxHp) this.hp = Math.min(this.maxHp, this.hp + this.regen * dt);

    // combo timer
    if (this.comboTimer > 0) { this.comboTimer -= dt; if (this.comboTimer <= 0) this.combo = 1; }

    // powerup timers
    for (const key of Object.keys(this.activePowerups)) {
      const a = this.activePowerups[key];
      if (a.t > 0) { a.t -= dt; if (a.t <= 0) { delete this.activePowerups[key]; if (key==='slow') Game.slowmo = 1; } }
    }

    // shield regen visuals handled in draw
  }
  draw() {
    const p = this;
    ctx.save();
    ctx.translate(p.x, p.y);
    // shield
    if (p.shieldHp > 0) {
      ctx.save();
      const pulse = 0.6 + Math.sin(Game.time*8)*0.15;
      glow(ctx, '#ffd23b', 18);
      ctx.strokeStyle = `rgba(255,210,59,${pulse})`;
      ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.arc(0,0,p.r+10,0,TAU); ctx.stroke();
      ctx.restore();
    }
    // invuln flicker
    if (p.invuln && Math.floor(Game.time*30)%2===0) ctx.globalAlpha = 0.4;
    ctx.rotate(p.angle);
    // body — sleek triangle ship
    glow(ctx, '#00e5ff', 16);
    ctx.fillStyle = '#0a2a3a';
    ctx.strokeStyle = '#00e5ff';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(p.r+4, 0);
    ctx.lineTo(-p.r, -p.r*0.8);
    ctx.lineTo(-p.r*0.5, 0);
    ctx.lineTo(-p.r, p.r*0.8);
    ctx.closePath();
    ctx.fill(); ctx.stroke();
    // cockpit
    noGlow(ctx);
    ctx.fillStyle = '#ffffff';
    ctx.beginPath(); ctx.arc(p.r*0.1, 0, 3, 0, TAU); ctx.fill();
    ctx.restore();
  }
}

/* ---------- Bullet ---------- */
class Bullet {
  constructor(x,y,angle,speed,dmg,pierce,r,crit) {
    this.x=x; this.y=y; this.r=r||4;
    this.vx=Math.cos(angle)*speed; this.vy=Math.sin(angle)*speed;
    this.dmg=dmg; this.pierce=pierce||0; this.alive=true; this.life=1.6;
    this.crit=crit;
  }
  update(dt) {
    this.x += this.vx*dt; this.y += this.vy*dt;
    this.life -= dt;
    if (this.life<=0 || this.x<-20||this.x>W+20||this.y<-20||this.y>H+20) this.alive=false;
  }
  draw() {
    ctx.save();
    glow(ctx, this.crit?'#ffd23b':'#00e5ff', 14);
    ctx.fillStyle = this.crit?'#ffe680':'#bfefff';
    ctx.beginPath(); ctx.arc(this.x,this.y,this.r,0,TAU); ctx.fill();
    // trail
    ctx.strokeStyle = this.crit?'rgba(255,210,59,0.5)':'rgba(0,229,255,0.4)';
    ctx.lineWidth = this.r;
    ctx.beginPath(); ctx.moveTo(this.x,this.y); ctx.lineTo(this.x-this.vx*0.02,this.y-this.vy*0.02); ctx.stroke();
    ctx.restore();
  }
}

class EnemyBullet {
  constructor(x,y,angle,speed,dmg) {
    this.x=x;this.y=y;this.r=5;
    this.vx=Math.cos(angle)*speed;this.vy=Math.sin(angle)*speed;
    this.dmg=dmg;this.alive=true;this.life=4;
  }
  update(dt){this.x+=this.vx*dt;this.y+=this.vy*dt;this.life-=dt;
    if(this.life<=0||this.x<-20||this.x>W+20||this.y<-20||this.y>H+20)this.alive=false;}
  draw(){
    ctx.save();glow(ctx,'#ff3b6b',12);
    ctx.fillStyle='#ff8aa0';ctx.beginPath();ctx.arc(this.x,this.y,this.r,0,TAU);ctx.fill();
    ctx.restore();
  }
}

/* ---------- Enemy ---------- */
class Enemy {
  constructor(x,y,type) {
    this.x=x;this.y=y;this.type=type;this.alive=true;
    this.vx=0;this.vy=0;this.hitFlash=0;
    this.shootTimer=rand(1,2);
    if (type==='chaser') { this.r=12; this.hp=30+Game.wave*4; this.speed=90+Game.wave*3; this.color='#ff3b6b'; this.contactDmg=12; this.xpValue=2; this.scoreValue=10; }
    else if (type==='shooter') { this.r=14; this.hp=40+Game.wave*5; this.speed=60+Game.wave*2; this.color='#b388ff'; this.contactDmg=10; this.xpValue=3; this.scoreValue=15; this.shootRange=320; }
    else if (type==='tank') { this.r=22; this.hp=160+Game.wave*12; this.speed=40+Game.wave; this.color='#ff8a3b'; this.contactDmg=22; this.xpValue=6; this.scoreValue=40; }
    this.maxHp=this.hp;
    this.spawnT=0.4; // spawn fade-in
    this.angle=0;
  }
  damage(dmg, hx, hy) {
    this.hp -= dmg;
    this.hitFlash = 0.12;
    Audio.hit();
    Game.floaters.push(new Floater(hx,hy, Math.round(dmg), dmg>=30?'#ffd23b':'#ffffff', dmg>=30?20:14));
    // hit particles
    for (let i=0;i<4;i++) Game.particles.push(new Particle(hx,hy,rand(0,TAU),rand(40,140),rand(0.15,0.35),this.color,rand(1.5,3)));
    if (this.hp<=0) this.die();
    // lifesteal
    if (Game.player.lifesteal>0) Game.player.hp = Math.min(Game.player.maxHp, Game.player.hp + dmg*Game.player.lifesteal);
  }
  die() {
    this.alive=false;
    Game.kills++;
    Audio.explode();
    Game.addShake(3);
    // explosion particles
    for (let i=0;i<18;i++) Game.particles.push(new Particle(this.x,this.y,rand(0,TAU),rand(60,260),rand(0.3,0.8),pick([this.color,'#ffffff','#ffd23b']),rand(2,4.5)));
    // score & combo
    Game.player.combo = Math.min(Game.player.combo + 1, 99);
    Game.player.comboTimer = 3;
    Game.player.addScore(this.scoreValue);
    // drop orbs
    const orbCount = this.type==='tank'?6:2;
    for (let i=0;i<orbCount;i++) Game.orbs.push(new Orb(this.x+rand(-15,15),this.y+rand(-15,15),1));
    // chance for powerup
    if (Math.random() < (this.type==='tank'?0.6:0.08)) {
      Game.powerups.push(new Powerup(this.x,this.y));
    }
  }
  update(dt) {
    if (this.spawnT>0) { this.spawnT-=dt; return; }
    const p = Game.player;
    const d = Math.hypot(p.x-this.x,p.y-this.y);
    this.angle = Math.atan2(p.y-this.y,p.x-this.x);
    if (this.type==='shooter') {
      // keep distance
      const target = this.shootRange;
      const dir = d < target ? -1 : 1;
      this.vx = lerp(this.vx, Math.cos(this.angle)*this.speed*dir, 1-Math.pow(0.001,dt));
      this.vy = lerp(this.vy, Math.sin(this.angle)*this.speed*dir, 1-Math.pow(0.001,dt));
      this.shootTimer -= dt;
      if (this.shootTimer<=0 && d < this.shootRange+60) {
        this.shootTimer = rand(1.4,2.2);
        Game.enemyBullets.push(new EnemyBullet(this.x,this.y,this.angle,260,10));
        Audio.enemyShoot();
      }
    } else {
      this.vx = lerp(this.vx, Math.cos(this.angle)*this.speed, 1-Math.pow(0.001,dt));
      this.vy = lerp(this.vy, Math.sin(this.angle)*this.speed, 1-Math.pow(0.001,dt));
    }
    // separation from other enemies
    for (const e of Game.enemies) {
      if (e===this||!e.alive) continue;
      const dd = dist2(this.x,this.y,e.x,e.y);
      const min = (this.r+e.r);
      if (dd < min*min && dd>0.01) {
        const dl = Math.sqrt(dd);
        const [nx,ny] = norm(this.x-e.x,this.y-e.y);
        this.vx += nx*60; this.vy += ny*60;
      }
    }
    this.x += this.vx*dt; this.y += this.vy*dt;
    if (this.hitFlash>0) this.hitFlash-=dt;
  }
  draw() {
    ctx.save();
    ctx.translate(this.x,this.y);
    const spawnAlpha = this.spawnT>0 ? 1-this.spawnT/0.4 : 1;
    ctx.globalAlpha = spawnAlpha;
    const col = this.hitFlash>0 ? '#ffffff' : this.color;
    glow(ctx, this.color, 14);
    ctx.fillStyle = col; ctx.strokeStyle = '#ffffff'; ctx.lineWidth=1.5;
    if (this.type==='chaser') {
      ctx.rotate(this.angle);
      ctx.beginPath();
      ctx.moveTo(this.r,0);ctx.lineTo(-this.r*0.7,-this.r*0.7);ctx.lineTo(-this.r*0.7,this.r*0.7);
      ctx.closePath(); ctx.fill(); ctx.stroke();
    } else if (this.type==='shooter') {
      ctx.rotate(this.angle);
      ctx.beginPath();
      ctx.moveTo(this.r,0);ctx.lineTo(0,-this.r);ctx.lineTo(-this.r*0.8,0);ctx.lineTo(0,this.r);
      ctx.closePath(); ctx.fill(); ctx.stroke();
      noGlow(ctx); ctx.fillStyle='#ffffff'; ctx.beginPath(); ctx.arc(0,0,3,0,TAU); ctx.fill();
    } else { // tank
      ctx.beginPath();
      const sides=6;
      for (let i=0;i<sides;i++){const a=i/sides*TAU;const px=Math.cos(a)*this.r,py=Math.sin(a)*this.r; i?ctx.lineTo(px,py):ctx.moveTo(px,py);}
      ctx.closePath(); ctx.fill(); ctx.stroke();
      noGlow(ctx); ctx.fillStyle='#ffffff'; ctx.beginPath(); ctx.arc(0,0,this.r*0.35,0,TAU); ctx.fill();
    }
    ctx.restore();
    // hp bar for tanks
    if (this.type==='tank' && this.hp<this.maxHp) {
      ctx.save();
      const bw=this.r*2;
      ctx.fillStyle='rgba(0,0,0,0.5)'; ctx.fillRect(this.x-bw/2,this.y-this.r-10,bw,4);
      ctx.fillStyle='#ff8a3b'; ctx.fillRect(this.x-bw/2,this.y-this.r-10,bw*(this.hp/this.maxHp),4);
      ctx.restore();
    }
  }
}

/* ---------- Boss ---------- */
class Boss {
  constructor(x,y) {
    this.x=x;this.y=y;this.r=46;this.alive=true;
    this.maxHp=1200+Game.wave*120;this.hp=this.maxHp;
    this.vx=0;this.vy=0;this.angle=0;
    this.phase=1;this.phaseT=0;this.attackTimer=2;
    this.hitFlash=0;this.spawnT=1.2;
    this.scoreValue=500;this.xpValue=40;
    this.contactDmg=24;
  }
  damage(dmg,hx,hy){
    this.hp-=dmg;this.hitFlash=0.1;Audio.hit();
    Game.floaters.push(new Floater(hx,hy,Math.round(dmg),dmg>=40?'#ffd23b':'#ffffff',dmg>=40?22:16));
    for(let i=0;i<3;i++)Game.particles.push(new Particle(hx,hy,rand(0,TAU),rand(40,140),rand(0.15,0.3),'#ff3b6b',rand(2,4)));
    if(this.hp<=0)this.die();
  }
  die(){
    this.alive=false;Game.boss=null;
    Audio.bigExplode();Game.addShake(26);Game.addFlash('#ff3b6b',0.8);
    for(let i=0;i<80;i++)Game.particles.push(new Particle(this.x,this.y,rand(0,TAU),rand(80,400),rand(0.5,1.4),pick(['#ff3b6b','#ffd23b','#ffffff','#ff8a3b']),rand(3,6)));
    Game.player.combo=Math.min(Game.player.combo+5,99);Game.player.comboTimer=3;
    Game.player.addScore(this.scoreValue);
    for(let i=0;i<25;i++)Game.orbs.push(new Orb(this.x+rand(-30,30),this.y+rand(-30,30),2));
    Game.powerups.push(new Powerup(this.x,this.y));
    Game.powerups.push(new Powerup(this.x+30,this.y));
    document.getElementById('bossBarWrap').style.display='none';
    Game.showBanner('BOSS DEFEATED','#ffd23b');
    Game.waveActive=false;Game.waveTimer=0;
  }
  update(dt){
    if(this.spawnT>0){this.spawnT-=dt;return;}
    const p=Game.player;
    this.angle=Math.atan2(p.y-this.y,p.x-this.x);
    const d=Math.hypot(p.x-this.x,p.y-this.y);
    // movement: hover and approach
    const targetD=220;
    const dir=d<targetD?-0.5:1;
    this.vx=lerp(this.vx,Math.cos(this.angle)*70*dir,1-Math.pow(0.001,dt));
    this.vy=lerp(this.vy,Math.sin(this.angle)*70*dir,1-Math.pow(0.001,dt));
    this.x+=this.vx*dt;this.y+=this.vy*dt;
    this.x=clamp(this.x,this.r,W-this.r);this.y=clamp(this.y,this.r,H-this.r);
    // attacks
    this.attackTimer-=dt;
    if(this.attackTimer<=0){
      this.phase=(this.phase%3)+1;
      this.attackTimer = this.phase===1?2.2:this.phase===2?3:1.6;
      if(this.phase===1){
        // radial burst
        const n=18;
        for(let i=0;i<n;i++){
          const a=i/n*TAU+Game.time;
          Game.enemyBullets.push(new EnemyBullet(this.x,this.y,a,200,12));
        }
        Audio.boss();
      } else if(this.phase===2){
        // aimed spread
        for(let i=-2;i<=2;i++){
          Game.enemyBullets.push(new EnemyBullet(this.x,this.y,this.angle+i*0.18,320,14));
        }
        Audio.enemyShoot();
      } else {
        // spiral burst
        for(let i=0;i<8;i++){
          const a=this.angle+ (i-3.5)*0.12;
          Game.enemyBullets.push(new EnemyBullet(this.x,this.y,a,260,11));
        }
        Audio.enemyShoot();
      }
    }
    if(this.hitFlash>0)this.hitFlash-=dt;
    if(this.hp<this.maxHp*0.33&&this.phaseT===0){this.phaseT=1;this.attackTimer=0.5;}
  }
  draw(){
    ctx.save();ctx.translate(this.x,this.y);
    const sa=this.spawnT>0?1-this.spawnT/1.2:1;
    ctx.globalAlpha=sa;
    const col=this.hitFlash>0?'#ffffff':'#ff3b6b';
    glow(ctx,'#ff3b6b',30);
    ctx.rotate(Game.time*0.4);
    ctx.fillStyle=col;ctx.strokeStyle='#ffffff';ctx.lineWidth=2.5;
    // outer ring
    ctx.beginPath();
    const sides=8;
    for(let i=0;i<sides;i++){const a=i/sides*TAU;const px=Math.cos(a)*this.r,py=Math.sin(a)*this.r;i?ctx.lineTo(px,py):ctx.moveTo(px,py);}
    ctx.closePath();ctx.fill();ctx.stroke();
    ctx.rotate(-Game.time*0.8);
    noGlow(ctx);
    ctx.fillStyle='#0a0010';ctx.beginPath();ctx.arc(0,0,this.r*0.55,0,TAU);ctx.fill();
    glow(ctx,'#ffd23b',20);
    ctx.fillStyle='#ff8a3b';ctx.beginPath();ctx.arc(0,0,this.r*0.3+Math.sin(Game.time*6)*2,0,TAU);ctx.fill();
    ctx.restore();
  }
}

/* ---------- Particle ---------- */
class Particle {
  constructor(x,y,angle,speed,life,color,size) {
    this.x=x;this.y=y;
    this.vx=Math.cos(angle)*speed;this.vy=Math.sin(angle)*speed;
    this.life=life;this.maxLife=life;this.color=color;this.size=size;this.alive=true;
  }
  update(dt){this.x+=this.vx*dt;this.y+=this.vy*dt;this.vx*=Math.pow(0.02,dt);this.vy*=Math.pow(0.02,dt);this.life-=dt;if(this.life<=0)this.alive=false;}
  draw(){
    const a=clamp(this.life/this.maxLife,0,1);
    ctx.save();
    ctx.globalAlpha=a;
    glow(ctx,this.color,8);
    ctx.fillStyle=this.color;
    ctx.beginPath();ctx.arc(this.x,this.y,this.size*a,0,TAU);ctx.fill();
    ctx.restore();
  }
}

/* ---------- Orb (XP pickup) ---------- */
class Orb {
  constructor(x,y,value){
    this.x=x;this.y=y;this.r=6;this.value=value||1;
    this.vx=rand(-60,60);this.vy=rand(-60,60);
    this.alive=true;this.life=14;this.t=rand(0,TAU);
  }
  update(dt){
    this.t+=dt*5;
    this.vx*=Math.pow(0.1,dt);this.vy*=Math.pow(0.1,dt);
    this.x+=this.vx*dt;this.y+=this.vy*dt;
    this.life-=dt;if(this.life<=0)this.alive=false;
  }
  draw(){
    ctx.save();
    const pulse=0.7+Math.sin(this.t)*0.3;
    glow(ctx,'#7dff8a',12);
    ctx.fillStyle='#7dff8a';
    ctx.globalAlpha=clamp(this.life/2,0,1);
    ctx.beginPath();ctx.arc(this.x,this.y,this.r*pulse,0,TAU);ctx.fill();
    ctx.restore();
  }
}

/* ---------- Powerup ---------- */
const POWERUP_TYPES = ['rapid','spread','shield','heal','slow','damage'];
const POWERUP_META = {
  rapid:{color:'#00e5ff'},spread:{color:'#7dff8a'},shield:{color:'#ffd23b'},
  heal:{color:'#ff8a3b'},slow:{color:'#b388ff'},damage:{color:'#ff3b6b'}
};
class Powerup {
  constructor(x,y){
    this.x=x;this.y=y;this.r=13;
    this.type=pick(POWERUP_TYPES);
    this.color=POWERUP_META[this.type].color;
    this.label=POWERUP_META[this.type].label||this.type.toUpperCase();
    this.alive=true;this.life=16;this.t=0;this.vx=rand(-30,30);this.vy=rand(-30,30);
  }
  update(dt){
    this.t+=dt;this.vx*=Math.pow(0.1,dt);this.vy*=Math.pow(0.1,dt);
    this.x+=this.vx*dt;this.y+=this.vy*dt;
    this.life-=dt;if(this.life<=0)this.alive=false;
  }
  draw(){
    ctx.save();
    const blink=this.life<4?Math.floor(this.t*8)%2:1;
    if(!blink){ctx.restore();return;}
    const pulse=0.8+Math.sin(this.t*4)*0.2;
    ctx.translate(this.x,this.y);
    glow(ctx,this.color,18);
    ctx.rotate(this.t*1.5);
    ctx.strokeStyle=this.color;ctx.lineWidth=2.5;
    ctx.fillStyle='rgba(8,12,28,0.8)';
    ctx.beginPath();
    const s=this.r*pulse;
    ctx.moveTo(0,-s);ctx.lineTo(s,0);ctx.lineTo(0,s);ctx.lineTo(-s,0);
    ctx.closePath();ctx.fill();ctx.stroke();
    noGlow(ctx);ctx.fillStyle=this.color;
    ctx.beginPath();ctx.arc(0,0,3,0,TAU);ctx.fill();
    ctx.restore();
  }
}

/* ---------- Floating text ---------- */
class Floater {
  constructor(x,y,text,color,size){
    this.x=x;this.y=y;this.text=text;this.color=color||'#ffffff';this.size=size||14;
    this.vy=-40;this.life=0.9;this.maxLife=0.9;this.alive=true;
  }
  update(dt){this.y+=this.vy*dt;this.vy*=Math.pow(0.1,dt);this.life-=dt;if(this.life<=0)this.alive=false;}
  draw(){
    const a=clamp(this.life/this.maxLife,0,1);
    ctx.save();ctx.globalAlpha=a;
    ctx.font=`800 ${this.size}px 'Segoe UI', sans-serif`;
    ctx.textAlign='center';
    glow(ctx,this.color,6);
    ctx.fillStyle=this.color;
    ctx.fillText(this.text,this.x,this.y);
    ctx.restore();
  }
}

/* ---------- Upgrade system ---------- */
const UPGRADES = [
  { id:'dmg', name:'Damage Up', desc:'+25% bullet damage', color:'#ff3b6b', apply:p=>{ p.bulletDmg *= 1.25; } },
  { id:'rate', name:'Fire Rate', desc:'-12% fire cooldown', color:'#00e5ff', apply:p=>{ p.fireRate *= 0.88; } },
  { id:'speed', name:'Move Speed', desc:'+15% movement speed', color:'#7dff8a', apply:p=>{ p.speed *= 1.15; } },
  { id:'hp', name:'Max Hull', desc:'+25 max hull & full repair', color:'#ff8a3b', apply:p=>{ p.maxHp += 25; p.hp = p.maxHp; } },
  { id:'pierce', name:'Piercing Rounds', desc:'+1 bullet pierce', color:'#b388ff', apply:p=>{ p.pierce += 1; } },
  { id:'multi', name:'Multishot', desc:'+1 projectile per shot', color:'#ffd23b', apply:p=>{ p.multishot += 1; p.spread = Math.max(p.spread, 0.18); } },
  { id:'regen', name:'Nanorepair', desc:'+1.5 hull/sec regen', color:'#7dff8a', apply:p=>{ p.regen += 1.5; } },
  { id:'crit', name:'Critical Systems', desc:'+10% crit chance (x2 dmg)', color:'#ffd23b', apply:p=>{ p.critChance += 0.1; } },
  { id:'life', name:'Lifesteal', desc:'+4% lifesteal', color:'#ff3b6b', apply:p=>{ p.lifesteal += 0.04; } },
  { id:'bulletspd', name:'Velocity', desc:'+20% bullet speed', color:'#00e5ff', apply:p=>{ p.bulletSpeed *= 1.2; p.bulletR += 0.5; } },
];
function showUpgrades() {
  const menu = document.getElementById('upgradeMenu');
  const choices = document.getElementById('upgradeChoices');
  menu.classList.remove('hidden'); menu.classList.add('active');
  choices.innerHTML = '';
  // pick 3 random unique
  const pool = [...UPGRADES].sort(()=>Math.random()-0.5).slice(0,3);
  for (const up of pool) {
    const card = document.createElement('div');
    card.style.cssText = `width:180px;padding:18px 14px;border-radius:12px;cursor:pointer;background:rgba(8,12,28,0.9);border:2px solid ${up.color};box-shadow:0 0 20px ${up.color}55;transition:transform .12s, box-shadow .12s;`;
    card.innerHTML = `<div style="color:${up.color};font-weight:800;font-size:16px;letter-spacing:1px;margin-bottom:6px">${up.name}</div><div style="color:#9fc0d8;font-size:12px;line-height:1.4">${up.desc}</div>`;
    card.onmouseenter = ()=>{ card.style.transform='translateY(-4px) scale(1.04)'; card.style.boxShadow=`0 0 32px ${up.color}aa`; };
    card.onmouseleave = ()=>{ card.style.transform=''; card.style.boxShadow=`0 0 20px ${up.color}55`; };
    card.onclick = ()=>{
      up.apply(Game.player);
      menu.classList.add('hidden'); menu.classList.remove('active');
      Game.pendingUpgrades--;
      if (Game.pendingUpgrades > 0) showUpgrades();
      else Game.state = 'playing';
      Audio.levelup();
    };
    choices.appendChild(card);
  }
}

/* ---------- Buttons ---------- */
document.getElementById('startBtn').onclick = () => Game.start();
document.getElementById('retryBtn').onclick = () => Game.start();
document.getElementById('resumeBtn').onclick = () => Game.togglePause();

/* ---------- Main loop ---------- */
let last = performance.now();
function loop(now) {
  const dt = Math.min((now - last) / 1000, 0.05);
  last = now;
  Game.update(dt);
  Game.render();
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

</script>
</body>
</html>
