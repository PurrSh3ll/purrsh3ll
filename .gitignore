# Cyb3rCollector — dane runtime (listeners, stagers, webmap scans, reports).
# Folder tworzony przy starcie przez controller, więc nie potrzeba .gitkeep.
appmodules/Cyb3rCollector/

# BrainDump — prywatne notatki i pliki RAG (nie wersjonujemy)
appmodules/BrainDump/*
!appmodules/BrainDump/user_guide.md

# AI Skills — klonowane na żądanie przez installer (nie wersjonujemy).
# Nie są to submoduły ani vendored — dzięki temu goły `git clone` jest czysty.
appdata/agent_modes/skills/

# Cyb3rBreak — gry klonowane na żądanie przez installer z repo cyb3rbreak-games
# (opcja domyślnie zaznaczona). Nie vendorujemy — goły `git clone` nie ma folderu,
# a aplikacja startuje bez niego (nie jest tworzony przy starcie).
appmodules/Cyb3rBreak/

# PURRCON recon tool — script + runtime SQLite DB, kept out of commits entirely.
purrideas/

# pshunter — runtime SQLite DB (discovered hosts), not source.
appdata/pshunter.db*

# purragent — runtime SQLite DB (hacking-mode engagements + target intake,
# holds credentials), not source.
appdata/purragent.db*

# pshunter — seeded sample database for local UI testing, not source.
pshunter_test/

# Pre-refactor source backups (monolith splits) — scratch, not source.
_refactor_backups/

# pshunter — offline CPE→CVE index, generated by the installer from NVD, not source.
appdata/cve_index.db*

# Ukryty workspace agenta Claude Code (cwd + kopie CLAUDE.md/goal/skills, oraz
# zagnieżdżone repo git izolujące agenta od źródeł aplikacji). Poza qtree.
appdata/agent_workspace/

